{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "name": "dataset"
  },
  "width": "container",
  "height": "container",
  "transform": [
    {
      "filter": "isValid(datum.ret)"
    },
    {
      "calculate": "'M' + datum.idade",
      "as": "m"
    }
  ],
  "encoding": {
    "x": {
      "field": "idade",
      "type": "ordinal",
      "axis": {
        "title": null,
        "orient": "top",
        "labelExpr": "'M' + datum.value",
        "labelColor": "#A9BBD8",
        "domain": false,
        "ticks": false,
        "labelFontSize": 11,
        "labelFontWeight": 600,
        "labelAngle": 0
      }
    },
    "y": {
      "field": "cohort",
      "type": "ordinal",
      "sort": {
        "field": "cidx",
        "op": "min"
      },
      "axis": {
        "title": null,
        "labelColor": "#A9BBD8",
        "domain": false,
        "ticks": false,
        "labelFontSize": 10,
        "labelPadding": 6
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 3,
        "stroke": "#050D20",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "ret",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.5,
              0.72,
              0.86,
              1
            ],
            "range": [
              "#FF607A",
              "#6736F5",
              "#1678FF",
              "#00D7C0"
            ],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Retenção de logos",
            "format": ".0%",
            "gradientLength": 320,
            "gradientThickness": 8,
            "titleFontSize": 11,
            "labelFontSize": 10
          }
        },
        "tooltip": [
          {
            "field": "cohort",
            "title": "Cohort"
          },
          {
            "field": "m",
            "title": "Idade"
          },
          {
            "field": "rot",
            "title": "Retenção"
          },
          {
            "field": "base",
            "title": "Clientes iniciais"
          },
          {
            "field": "ativos",
            "title": "Ativos"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 9.5,
        "fontWeight": 600,
        "color": "#FFFFFF"
      },
      "encoding": {
        "text": {
          "field": "rot"
        }
      }
    }
  ]
}