{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "name": "dataset"
  },
  "width": "container",
  "height": "container",
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "mrr",
          "as": "mx"
        }
      ]
    },
    {
      "calculate": "datum.mrr / datum.mx * 0.62",
      "as": "f"
    },
    {
      "calculate": "0.62",
      "as": "trilho"
    }
  ],
  "encoding": {
    "y": {
      "field": "plano",
      "type": "nominal",
      "sort": {
        "field": "ordem",
        "op": "min"
      },
      "axis": {
        "title": null,
        "labelFontSize": 13.5,
        "labelColor": "#FFFFFF",
        "labelFontWeight": 600,
        "domain": false,
        "ticks": false,
        "labelPadding": 12
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadius": 8,
        "height": {
          "band": 0.5
        },
        "color": "#1E3462",
        "opacity": 0.55
      },
      "encoding": {
        "x": {
          "field": "trilho",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "axis": null
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "cornerRadius": 8,
        "height": {
          "band": 0.5
        }
      },
      "encoding": {
        "x": {
          "field": "f",
          "type": "quantitative"
        },
        "color": {
          "field": "cor",
          "type": "nominal",
          "scale": null
        },
        "tooltip": [
          {
            "field": "plano",
            "title": "Plano"
          },
          {
            "field": "rotulo",
            "title": "MRR · participação"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#FFFFFF"
      },
      "encoding": {
        "x": {
          "field": "trilho",
          "type": "quantitative"
        },
        "text": {
          "field": "rotulo"
        }
      }
    }
  ]
}