{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "name": "dataset"
  },
  "width": "container",
  "height": "container",
  "transform": [
    {
      "filter": "datum.tipo != 'migr' || abs(datum.valor) >= 1"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "valor",
          "as": "acum"
        }
      ],
      "sort": [
        {
          "field": "ordem"
        }
      ]
    },
    {
      "calculate": "(datum.tipo == 'fim' || datum.tipo == 'inicio') ? 0 : datum.acum - datum.valor",
      "as": "y0"
    },
    {
      "calculate": "datum.tipo == 'fim' ? datum.valor : datum.acum",
      "as": "y1"
    },
    {
      "window": [
        {
          "op": "lead",
          "field": "etapa",
          "as": "prox"
        }
      ],
      "sort": [
        {
          "field": "ordem"
        }
      ]
    },
    {
      "calculate": "max(datum.y0, datum.y1)",
      "as": "topo"
    }
  ],
  "encoding": {
    "x": {
      "field": "etapa",
      "type": "nominal",
      "sort": {
        "field": "ordem",
        "op": "min"
      },
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelFontSize": 12.5,
        "labelColor": "#DCE6F7",
        "labelFontWeight": 600,
        "domain": false,
        "ticks": false,
        "labelPadding": 12
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadius": 7,
        "width": {
          "band": 0.62
        }
      },
      "encoding": {
        "y": {
          "field": "y0",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "zero": true,
            "nice": true
          }
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "tipo",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "inicio",
              "ganho",
              "migr",
              "perda",
              "fim"
            ],
            "range": [
              "#1678FF",
              "#00D7C0",
              "#6E86B3",
              "#FF607A",
              "#6736F5"
            ]
          }
        },
        "tooltip": [
          {
            "field": "etapa",
            "title": "Etapa"
          },
          {
            "field": "rotulo",
            "title": "Valor"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.prox != null"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#A9BBD8",
        "opacity": 0.6,
        "strokeDash": [
          4,
          3
        ],
        "strokeWidth": 1.4,
        "xOffset": {
          "expr": "bandwidth('x') * 0.31"
        },
        "x2Offset": {
          "expr": "-bandwidth('x') * 0.31"
        }
      },
      "encoding": {
        "x2": {
          "field": "prox"
        },
        "y": {
          "field": "y1",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -11,
        "fontSize": 13.5,
        "fontWeight": 700,
        "color": "#FFFFFF"
      },
      "encoding": {
        "y": {
          "field": "topo",
          "type": "quantitative"
        },
        "text": {
          "field": "rotulo"
        }
      }
    }
  ]
}