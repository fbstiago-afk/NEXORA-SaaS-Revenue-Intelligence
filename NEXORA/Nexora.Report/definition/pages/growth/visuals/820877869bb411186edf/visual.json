            },
            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n  \"width\": \"container\",\n  \"height\": \"container\",\n  \"transform\": [\n    {\n      \"filter\": \"datum.valor > 0\"\n    },\n    {\n      \"calculate\": \"log(datum.valor)\",\n      \"as\": \"lv\"\n    },\n    {\n      \"joinaggregate\": [\n        {\n          \"op\": \"max\",\n          \"field\": \"lv\",\n          \"as\": \"lmax\"\n        },\n        {\n          \"op\": \"min\",\n          \"field\": \"lv\",\n          \"as\": \"lmin\"\n        }\n      ]\n    },\n    {\n      \"calculate\": \"0.30 + 0.70 * (datum.lv - datum.lmin) / (datum.lmax - datum.lmin)\",\n      \"as\": \"w\"\n    },\n    {\n      \"calculate\": \"0.5 - datum.w / 2\",\n      \"as\": \"x0\"\n    },\n    {\n      \"calculate\": \"0.5 + datum.w / 2\",\n      \"as\": \"x1\"\n    },\n    {\n      \"calculate\": \"0.5\",\n      \"as\": \"xc\"\n    }\n  ],\n  \"encoding\": {\n    \"y\": {\n      \"field\": \"etapa\",\n      \"type\": \"nominal\",\n      \"sort\": {\n        \"field\": \"ordem\",\n        \"op\": \"min\"\n      },\n      \"axis\": null,\n      \"scale\": {\n        \"paddingInner\": 0.42,\n        \"paddingOuter\": 0.15\n      }\n    }\n  },\n  \"layer\": [\n    {\n      \"mark\": {\n        \"type\": \"bar\",\n        \"cornerRadius\": 10\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"x0\",\n          \"type\": \"quantitative\",\n          \"scale\": {\n            \"domain\": [\n              0,\n              1\n            ]\n          },\n          \"axis\": null\n        },\n        \"x2\": {\n          \"field\": \"x1\"\n        },\n        \"color\": {\n          \"field\": \"ordem\",\n          \"type\": \"quantitative\",\n          \"legend\": null,\n          \"scale\": {\n            \"domain\": [\n              1,\n              6\n            ],\n            \"range\": [\n              \"#00B8F5\",\n              \"#6736F5\"\n            ]\n          }\n        },\n        \"tooltip\": [\n          {\n            \"field\": \"etapa\",\n            \"title\": \"Etapa\"\n          },\n          {\n            \"field\": \"rotulo\",\n            \"title\": \"Volume\"\n          },\n          {\n            \"field\": \"conv\",\n            \"title\": \"Conversão\"\n          }\n        ]\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"text\",\n        \"fontSize\": 12,\n        \"fontWeight\": 600,\n        \"color\": \"#DCE6F7\",\n        \"dy\": -10\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"xc\",\n          \"type\": \"quantitative\"\n        },\n        \"text\": {\n          \"field\": \"etapa\"\n        }\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"text\",\n        \"fontSize\": 17,\n        \"fontWeight\": 700,\n        \"color\": \"#FFFFFF\",\n        \"dy\": 10\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"xc\",\n          \"type\": \"quantitative\"\n        },\n        \"text\": {\n          \"field\": \"rotulo\"\n        }\n      }\n    },\n    {\n      \"transform\": [\n        {\n          \"filter\": \"isValid(datum.conv) && datum.conv != ''''\"\n        }\n      ],\n      \"mark\": {\n        \"type\": \"text\",\n        \"fontSize\": 11,\n        \"fontWeight\": 600,\n        \"color\": \"#00D7C0\",\n        \"dy\": {\n          \"expr\": \"-bandwidth(''y'') * 0.86\"\n        }\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"xc\",\n          \"type\": \"quantitative\"\n        },\n        \"text\": {\n          \"field\": \"conv\"\n        }\n      }\n    }\n  ]\n}'"
                }
              }
