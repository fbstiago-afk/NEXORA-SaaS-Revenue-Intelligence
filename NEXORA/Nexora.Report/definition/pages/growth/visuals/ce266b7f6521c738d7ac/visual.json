            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n  \"width\": \"container\",\n  \"height\": \"container\",\n  \"transform\": [\n    {\n      \"filter\": \"datum.ltv > 0\"\n    },\n    {\n      \"joinaggregate\": [\n        {\n          \"op\": \"max\",\n          \"field\": \"ltv\",\n          \"as\": \"mx\"\n        }\n      ]\n    },\n    {\n      \"calculate\": \"datum.ltv / datum.mx * 0.58\",\n      \"as\": \"fl\"\n    },\n    {\n      \"calculate\": \"datum.cac / datum.mx * 0.58\",\n      \"as\": \"fc\"\n    },\n    {\n      \"calculate\": \"0.58\",\n      \"as\": \"trilho\"\n    },\n    {\n      \"calculate\": \"0.60\",\n      \"as\": \"xr\"\n    },\n    {\n      \"calculate\": \"0.67\",\n      \"as\": \"xt\"\n    },\n    {\n      \"calculate\": \"''LTV '' + datum.ltvTxt + ''  ·  CAC '' + datum.cacTxt\",\n      \"as\": \"det\"\n    }\n  ],\n  \"encoding\": {\n    \"y\": {\n      \"field\": \"canal\",\n      \"type\": \"nominal\",\n      \"sort\": {\n        \"field\": \"ratio\",\n        \"op\": \"max\",\n        \"order\": \"descending\"\n      },\n      \"axis\": {\n        \"title\": null,\n        \"labelFontSize\": 12.5,\n        \"labelColor\": \"#FFFFFF\",\n        \"labelFontWeight\": 600,\n        \"domain\": false,\n        \"ticks\": false,\n        \"labelPadding\": 12\n      }\n    }\n  },\n  \"layer\": [\n    {\n      \"mark\": {\n        \"type\": \"bar\",\n        \"cornerRadius\": 6,\n        \"height\": {\n          \"band\": 0.62\n        },\n        \"color\": \"#1E3462\",\n        \"opacity\": 0.45\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"trilho\",\n          \"type\": \"quantitative\",\n          \"scale\": {\n            \"domain\": [\n              0,\n              1\n            ]\n          },\n          \"axis\": null\n        }\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"bar\",\n        \"cornerRadius\": 6,\n        \"height\": {\n          \"band\": 0.62\n        },\n        \"opacity\": 0.92\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"fl\",\n          \"type\": \"quantitative\"\n        },\n        \"color\": {\n          \"field\": \"cor\",\n          \"type\": \"nominal\",\n          \"scale\": null\n        },\n        \"tooltip\": [\n          {\n            \"field\": \"canal\",\n            \"title\": \"Canal\"\n          },\n          {\n            \"field\": \"ltvTxt\",\n            \"title\": \"LTV estimado\"\n          },\n          {\n            \"field\": \"cacTxt\",\n            \"title\": \"CAC\"\n          },\n          {\n            \"field\": \"rotulo\",\n            \"title\": \"LTV:CAC\"\n          }\n        ]\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"bar\",\n        \"cornerRadius\": 3,\n        \"height\": {\n          \"band\": 0.2\n        },\n        \"color\": \"#FFFFFF\",\n        \"opacity\": 0.92\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"fc\",\n          \"type\": \"quantitative\"\n        }\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"text\",\n        \"align\": \"left\",\n        \"fontSize\": 15,\n        \"fontWeight\": 700\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"xr\",\n          \"type\": \"quantitative\"\n        },\n        \"text\": {\n          \"field\": \"rotulo\"\n        },\n        \"color\": {\n          \"field\": \"cor\",\n          \"type\": \"nominal\",\n          \"scale\": null\n        }\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"text\",\n        \"align\": \"left\",\n        \"fontSize\": 11.5,\n        \"color\": \"#A9BBD8\"\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"xt\",\n          \"type\": \"quantitative\"\n        },\n        \"text\": {\n          \"field\": \"det\"\n        }\n      }\n    }\n  ]\n}'"
