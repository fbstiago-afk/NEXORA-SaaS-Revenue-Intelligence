            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n  \"width\": \"container\",\n  \"height\": \"container\",\n  \"transform\": [\n    {\n      \"filter\": \"datum.tipo != ''migr'' || abs(datum.valor) >= 1\"\n    },\n    {\n      \"window\": [\n        {\n          \"op\": \"sum\",\n          \"field\": \"valor\",\n          \"as\": \"acum\"\n        }\n      ],\n      \"sort\": [\n        {\n          \"field\": \"ordem\"\n        }\n      ]\n    },\n    {\n      \"calculate\": \"(datum.tipo == ''fim'' || datum.tipo == ''inicio'') ? 0 : datum.acum - datum.valor\",\n      \"as\": \"y0\"\n    },\n    {\n      \"calculate\": \"datum.tipo == ''fim'' ? datum.valor : datum.acum\",\n      \"as\": \"y1\"\n    },\n    {\n      \"window\": [\n        {\n          \"op\": \"lead\",\n          \"field\": \"etapa\",\n          \"as\": \"prox\"\n        }\n      ],\n      \"sort\": [\n        {\n          \"field\": \"ordem\"\n        }\n      ]\n    },\n    {\n      \"calculate\": \"max(datum.y0, datum.y1)\",\n      \"as\": \"topo\"\n    }\n  ],\n  \"encoding\": {\n    \"x\": {\n      \"field\": \"etapa\",\n      \"type\": \"nominal\",\n      \"sort\": {\n        \"field\": \"ordem\",\n        \"op\": \"min\"\n      },\n      \"axis\": {\n        \"title\": null,\n        \"labelAngle\": 0,\n        \"labelFontSize\": 12.5,\n        \"labelColor\": \"#DCE6F7\",\n        \"labelFontWeight\": 600,\n        \"domain\": false,\n        \"ticks\": false,\n        \"labelPadding\": 12\n      }\n    }\n  },\n  \"layer\": [\n    {\n      \"mark\": {\n        \"type\": \"bar\",\n        \"cornerRadius\": 7,\n        \"width\": {\n          \"band\": 0.62\n        }\n      },\n      \"encoding\": {\n        \"y\": {\n          \"field\": \"y0\",\n          \"type\": \"quantitative\",\n          \"axis\": null,\n          \"scale\": {\n            \"zero\": true,\n            \"nice\": true\n          }\n        },\n        \"y2\": {\n          \"field\": \"y1\"\n        },\n        \"color\": {\n          \"field\": \"tipo\",\n          \"type\": \"nominal\",\n          \"legend\": null,\n          \"scale\": {\n            \"domain\": [\n              \"inicio\",\n              \"ganho\",\n              \"migr\",\n              \"perda\",\n              \"fim\"\n            ],\n            \"range\": [\n              \"#1678FF\",\n              \"#00D7C0\",\n              \"#6E86B3\",\n              \"#FF607A\",\n              \"#6736F5\"\n            ]\n          }\n        },\n        \"tooltip\": [\n          {\n            \"field\": \"etapa\",\n            \"title\": \"Etapa\"\n          },\n          {\n            \"field\": \"rotulo\",\n            \"title\": \"Valor\"\n          }\n        ]\n      }\n    },\n    {\n      \"transform\": [\n        {\n          \"filter\": \"datum.prox != null\"\n        }\n      ],\n      \"mark\": {\n        \"type\": \"rule\",\n        \"color\": \"#A9BBD8\",\n        \"opacity\": 0.6,\n        \"strokeDash\": [\n          4,\n          3\n        ],\n        \"strokeWidth\": 1.4,\n        \"xOffset\": {\n          \"expr\": \"bandwidth(''x'') * 0.31\"\n        },\n        \"x2Offset\": {\n          \"expr\": \"-bandwidth(''x'') * 0.31\"\n        }\n      },\n      \"encoding\": {\n        \"x2\": {\n          \"field\": \"prox\"\n        },\n        \"y\": {\n          \"field\": \"y1\",\n          \"type\": \"quantitative\"\n        }\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"text\",\n        \"dy\": -11,\n        \"fontSize\": 13.5,\n        \"fontWeight\": 700,\n        \"color\": \"#FFFFFF\"\n      },\n      \"encoding\": {\n        \"y\": {\n          \"field\": \"topo\",\n          \"type\": \"quantitative\"\n        },\n        \"text\": {\n          \"field\": \"rotulo\"\n        }\n      }\n    }\n  ]\n}'"
                }
