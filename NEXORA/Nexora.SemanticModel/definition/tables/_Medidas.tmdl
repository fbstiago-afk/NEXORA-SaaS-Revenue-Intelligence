			    )
			VAR _sly = FORMAT ( 54 - DIVIDE ( MAXX ( FILTER ( _st, dCalendario[InicioMes] = _sx1 ), [@v] ) - _sy0, _sy1 - _sy0, 0.5 ) * 46, "0.0", "en-US" )
			VAR _spark =
