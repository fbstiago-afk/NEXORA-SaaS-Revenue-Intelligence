			VAR _spark =
			    IF (
			        _sn >= 2,
			        "<svg class='sp' viewBox='0 0 160 60' preserveAspectRatio='none'><defs><linearGradient id='lHTMLCardLTVCAC' x1='0' x2='1'><stop offset='0' stop-color='#00B8F5'/><stop offset='1' stop-color='#6736F5'/></linearGradient>"
			            & "<linearGradient id='aHTMLCardLTVCAC' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#00B8F5' stop-opacity='.38'/><stop offset='1' stop-color='#00B8F5' stop-opacity='0'/></linearGradient></defs>"
			            & "<polygon points='4,60 " & _spts & " 156,60' fill='url(#aHTMLCardLTVCAC)'/>"
			            & "<polyline points='" & _spts & "' fill='none' stroke='url(#lHTMLCardLTVCAC)' stroke-width='2.6' stroke-linejoin='round' stroke-linecap='round' vector-effect='non-scaling-stroke'/>"
			            & "<circle class='pl' cx='156' cy='" & _sly & "' r='3.2' fill='#FFFFFF'/></svg>"
			    )
			VAR _alert = _v < 3
			RETURN
			    [HTML CSS] & "<div class='nx card " & IF ( _alert, " al", "" ) & "'><div class='hd'><div class='ic'><svg viewBox='0 0 24 24' fill='none' stroke='#FFFFFF' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3v18M5 7h14M5 7l-3 7a3.5 3.5 0 0 0 6 0L5 7zM19 7l-3 7a3.5 3.5 0 0 0 6 0l-3-7z'/></svg></div><div class='lb'>LTV:CAC</div></div>"
			        & "<div class='vl'>" & _txt & "</div>"
			        & "<div class='dl " & _cls & "'>" & IF ( ISBLANK ( _d ), "<span class='nt'>sem base comparável</span>", _arrow & _dtxt ) & "</div>"
			        & "<div class='cmp'>" & IF ( ISBLANK ( _d ), "histórico insuficiente", _lbl ) & "</div>"
			        & _spark & "</div>"
		displayFolder: 07 SVG & HTML
		lineageTag: 5ff5fcaf-36a2-5d44-a871-0c6305889b10

	/// Card KPI HTML de [CAC Payback] com variação e sparkline SVG (12 meses).
	measure 'HTML Card Payback' =
			VAR _mx = MAX ( dCalendario[InicioMes] )
			VAR _mn = MIN ( dCalendario[InicioMes] )
			VAR _nm = DATEDIFF ( _mn, _mx, MONTH ) + 1
			VAR _pi = EDATE ( _mn, - _nm )
			VAR _temPrev = _pi >= DATE ( 2024, 1, 1 )
			VAR _v = [CAC Payback]
			VAR _cur =
			    IF ( _temPrev, _v, CALCULATE ( [CAC Payback], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] > EDATE ( _mx, -12 ), dCalendario[InicioMes] <= _mx ) )
			VAR _base =
			    IF (
			        _temPrev,
			        CALCULATE ( [CAC Payback], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] >= _pi, dCalendario[InicioMes] < _mn ),
			        IF ( EDATE ( _mx, -23 ) >= DATE ( 2024, 1, 1 ), CALCULATE ( [CAC Payback], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] > EDATE ( _mx, -24 ), dCalendario[InicioMes] <= EDATE ( _mx, -12 ) ) )
			    )
			VAR _lbl = IF ( _temPrev, "vs. período anterior equivalente", "últimos 12m vs. 12m anteriores" )
			VAR _d = IF ( NOT ISBLANK ( _base ) && _base <> 0, DIVIDE ( _cur - _base, ABS ( _base ) ) )
			VAR _dtxt = FORMAT ( ABS ( _d ), "0.0%", "pt-BR" )
			VAR _cls = IF ( ISBLANK ( _d ) || _d = 0, "nt", IF ( _d < 0, "up", "dn" ) )
			VAR _arrow = IF ( ISBLANK ( _d ), "", IF ( _d >= 0, "▲ ", "▼ " ) )
			VAR _txt = IF ( ISBLANK ( _v ), "–", FORMAT ( _v, "0.0", "pt-BR" ) & " <small>meses</small>" )
			VAR _sm = MAX ( dCalendario[InicioMes] )
			VAR _st =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( dCalendario[InicioMes] ), REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] > EDATE ( _sm, -12 ), dCalendario[InicioMes] <= _sm ),
			            "@v", VAR _mm = dCalendario[InicioMes] RETURN CALCULATE ( [CAC Payback], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] = _mm )
			        ),
			        NOT ISBLANK ( [@v] )
			    )
			VAR _sn = COUNTROWS ( _st )
			VAR _sx0 = MINX ( _st, dCalendario[InicioMes] )
			VAR _sx1 = MAXX ( _st, dCalendario[InicioMes] )
			VAR _sy0 = MINX ( _st, [@v] )
			VAR _sy1 = MAXX ( _st, [@v] )
			VAR _spts =
			    CONCATENATEX (
			        _st,
			        FORMAT ( 4 + DIVIDE ( INT ( dCalendario[InicioMes] - _sx0 ), INT ( _sx1 - _sx0 ), 0 ) * 152, "0.0", "en-US" ) & ","
			            & FORMAT ( 54 - DIVIDE ( [@v] - _sy0, _sy1 - _sy0, 0.5 ) * 46, "0.0", "en-US" ),
			        " ", dCalendario[InicioMes], ASC
			    )
			VAR _sly = FORMAT ( 54 - DIVIDE ( MAXX ( FILTER ( _st, dCalendario[InicioMes] = _sx1 ), [@v] ) - _sy0, _sy1 - _sy0, 0.5 ) * 46, "0.0", "en-US" )
			VAR _spark =
			    IF (
			        _sn >= 2,
			        "<svg class='sp' viewBox='0 0 160 60' preserveAspectRatio='none'><defs><linearGradient id='lHTMLCardPayback' x1='0' x2='1'><stop offset='0' stop-color='#00B8F5'/><stop offset='1' stop-color='#6736F5'/></linearGradient>"
			            & "<linearGradient id='aHTMLCardPayback' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#00B8F5' stop-opacity='.38'/><stop offset='1' stop-color='#00B8F5' stop-opacity='0'/></linearGradient></defs>"
			            & "<polygon points='4,60 " & _spts & " 156,60' fill='url(#aHTMLCardPayback)'/>"
			            & "<polyline points='" & _spts & "' fill='none' stroke='url(#lHTMLCardPayback)' stroke-width='2.6' stroke-linejoin='round' stroke-linecap='round' vector-effect='non-scaling-stroke'/>"
			            & "<circle class='pl' cx='156' cy='" & _sly & "' r='3.2' fill='#FFFFFF'/></svg>"
			    )
			VAR _alert = FALSE ()
			RETURN
			    [HTML CSS] & "<div class='nx card v" & IF ( _alert, " al", "" ) & "'><div class='hd'><div class='ic'><svg viewBox='0 0 24 24' fill='none' stroke='#FFFFFF' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><path d='M12 7v5l3 3'/></svg></div><div class='lb'>CAC Payback</div></div>"
			        & "<div class='vl'>" & _txt & "</div>"
			        & "<div class='dl " & _cls & "'>" & IF ( ISBLANK ( _d ), "<span class='nt'>sem base comparável</span>", _arrow & _dtxt ) & "</div>"
			        & "<div class='cmp'>" & IF ( ISBLANK ( _d ), "histórico insuficiente", _lbl ) & "</div>"
			        & _spark & "</div>"
		displayFolder: 07 SVG & HTML
		lineageTag: 132d0439-990d-597c-a090-a58b1a4353d0

	/// Cabeçalho HTML da página.
	measure 'HTML Header Executive' = [HTML CSS] & "<div class='nx hdr'><div class='eb'><span></span>01 · EXECUTIVE SAAS</div><div class='tt'>Visão <b>Executiva</b></div><div class='st'>Revenue, retenção e crescimento em uma única visão.</div></div>"
		displayFolder: 07 SVG & HTML
		lineageTag: 61177795-b532-5962-b331-a5b7246acb3a

	/// Cabeçalho HTML da página.
	measure 'HTML Header Revenue' = [HTML CSS] & "<div class='nx hdr'><div class='eb'><span></span>02 · REVENUE INTELLIGENCE</div><div class='tt'>Receita e <b>Expansão</b></div><div class='st'>Como o MRR cresce, expande e se perde — mês a mês.</div></div>"
		displayFolder: 07 SVG & HTML
		lineageTag: 74d25048-33d4-5a46-9922-b995326c0436

	/// Cabeçalho HTML da página.
	measure 'HTML Header Customer' = [HTML CSS] & "<div class='nx hdr'><div class='eb'><span></span>03 · CUSTOMER & RETENTION</div><div class='tt'>Clientes e <b>Retenção</b></div><div class='st'>Cohorts, churn, saúde da base e contas em risco.</div></div>"
