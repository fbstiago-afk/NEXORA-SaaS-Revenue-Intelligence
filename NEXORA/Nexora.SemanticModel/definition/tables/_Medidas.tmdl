	/// Mês atual = violeta; queda = vermelho; crescimento forte = ciano; demais = azul.
	measure 'Cor Coluna MRR' =
			VAR _sel = CALCULATE ( MAX ( dCalendario[InicioMes] ), ALLSELECTED ( dCalendario ) )
			VAR _m = MAX ( dCalendario[InicioMes] )
			VAR _g = [MRR MoM %]
			RETURN
			    SWITCH ( TRUE (), _m = _sel, "#6736F5", _g < 0, "#FF607A", _g >= 0.02, "#00B8F5", "#1678FF" )
		displayFolder: 08 Formatting
		lineageTag: 863ad2a0-cda7-50a2-8acf-0d23a23223e6

