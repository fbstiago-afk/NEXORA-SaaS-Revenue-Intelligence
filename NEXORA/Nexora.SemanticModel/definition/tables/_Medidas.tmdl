	measure 'Cor Destaque Expansion' =
			VAR _v = [Expansion MRR]
			VAR _max = CALCULATE ( MAXX ( VALUES ( dPlano[Plano] ), [Expansion MRR] ), ALLSELECTED ( dPlano ) )
			RETURN
			    IF ( _v = _max, "#00D7C0", "#1678FF" )
		displayFolder: 08 Formatting
		lineageTag: ad71622b-7846-50bf-b89f-87fe9695b81f

	/// CAC ≤ 80% da referência = turquesa; ≥ 120% = vermelho.
	measure 'Cor CAC Canal' =
			VAR _c = [CAC]
			VAR _ref = CALCULATE ( [CAC], ALLSELECTED ( dCanalAquisicao ) )
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _c ), "#6E86B3", _c <= _ref * 0.8, "#00D7C0", _c >= _ref * 1.2, "#FF607A", "#1678FF" )
		displayFolder: 08 Formatting
		lineageTag: ce8c17bc-c2af-5f41-8637-8f72334fd52d

	/// ≥ 3x saudável; 1,5–3x atenção; < 1,5x ineficiente.
	measure 'Cor LTV CAC' =
			VAR _r = [LTV:CAC]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _r ), "#6E86B3", _r >= 3, "#00D7C0", _r >= 1.5, "#F5A524", "#FF607A" )
		displayFolder: 08 Formatting
		lineageTag: 58061faa-aa93-56ab-a3f0-deaf8e6a7b84

