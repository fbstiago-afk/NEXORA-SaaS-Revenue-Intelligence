	/// Cabeçalho HTML da página.
	measure 'HTML Header Growth' = [HTML CSS] & "<div class='nx hdr'><div class='eb'><span></span>04 · GROWTH & UNIT ECONOMICS</div><div class='tt'>Growth e <b>Unit Economics</b></div><div class='st'>Eficiência de aquisição e qualidade do crescimento.</div></div>"
		displayFolder: 07 SVG & HTML
