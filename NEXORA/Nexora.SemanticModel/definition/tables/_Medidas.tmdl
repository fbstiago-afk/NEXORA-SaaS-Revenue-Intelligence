/// Tabela exclusiva de medidas do NEXORA SaaS Revenue Intelligence.
table _Medidas
	lineageTag: 8bb625b9-c438-53cb-bac9-fa04bf1ddf6f

	/// Último mês do contexto (referência para métricas de estoque).
	measure 'Mês Referência' = MAX ( dCalendario[InicioMes] )
		formatString: mmm/yy
		isHidden
		displayFolder: 01 Revenue
		lineageTag: 8fdde651-42ab-58dd-adea-dbe742e84046

	/// MRR no fim do mês anterior ao primeiro mês do contexto.
	measure 'Beginning MRR' =
			VAR _m0 = MIN ( dCalendario[InicioMes] )
			RETURN
			    COALESCE (
			        CALCULATE ( SUM ( fSnapshotMRR[MRR] ), REMOVEFILTERS ( dCalendario ), dCalendario[Data] = EDATE ( _m0, -1 ) ),
			        0
			    )
		formatString: "R$" #,0
		displayFolder: 01 Revenue
		lineageTag: 6c230ff9-ddb0-55d6-8c4e-613d77273528

	/// MRR no fim do último mês do contexto (estoque — nunca somado entre meses).
	measure 'Ending MRR' =
			VAR _m = MAX ( dCalendario[InicioMes] )
			RETURN
			    CALCULATE ( SUM ( fSnapshotMRR[MRR] ), REMOVEFILTERS ( dCalendario ), dCalendario[Data] = _m )
		formatString: "R$" #,0
		displayFolder: 01 Revenue
		lineageTag: d15347b9-490c-5bbf-a20f-c580710ab460

	/// Fluxo do período (New).
	measure 'New MRR' = CALCULATE ( SUM ( fMovimentoMRR[ValorMRR] ), fMovimentoMRR[TipoMovimento] = "New" )
		formatString: "R$" #,0
		displayFolder: 01 Revenue
		lineageTag: b8bb17fe-6cf9-55c1-baaf-c705ef4a1737

	/// Fluxo do período (Expansion).
	measure 'Expansion MRR' = CALCULATE ( SUM ( fMovimentoMRR[ValorMRR] ), fMovimentoMRR[TipoMovimento] = "Expansion" )
		formatString: "R$" #,0
		displayFolder: 01 Revenue
		lineageTag: de1b3dae-b582-5eff-9176-1354d7ea26d1

	/// Fluxo do período (Reactivation).
	measure 'Reactivation MRR' = CALCULATE ( SUM ( fMovimentoMRR[ValorMRR] ), fMovimentoMRR[TipoMovimento] = "Reactivation" )
		formatString: "R$" #,0
		displayFolder: 01 Revenue
		lineageTag: da998dba-12db-502e-8739-01cdd3fc2009

	/// Fluxo do período (Contraction). Exibido como valor positivo (perda).
	measure 'Contraction MRR' = - CALCULATE ( SUM ( fMovimentoMRR[ValorMRR] ), fMovimentoMRR[TipoMovimento] = "Contraction" )
		formatString: "R$" #,0
		displayFolder: 01 Revenue
		lineageTag: dd9e5d82-db66-5f49-9ffb-64448b93ce91

	/// Fluxo do período (Churn). Exibido como valor positivo (perda).
	measure 'Churned MRR' = - CALCULATE ( SUM ( fMovimentoMRR[ValorMRR] ), fMovimentoMRR[TipoMovimento] = "Churn" )
		formatString: "R$" #,0
		displayFolder: 01 Revenue
		lineageTag: 7aa48a3e-23e7-5868-ae0c-686894d1d525

	/// Entrada − saída de MRR por migração de plano. Soma zero no total; aparece apenas com filtro de plano.
	measure 'Migração Líquida MRR' = CALCULATE ( SUM ( fMovimentoMRR[ValorMRR] ), fMovimentoMRR[TipoMovimento] IN { "Plan Migration In", "Plan Migration Out" } )
		formatString: "R$" #,0
		displayFolder: 01 Revenue
		lineageTag: e350bc23-7829-578d-bdd7-d7204dc6daaf

	/// New + Expansion + Reactivation − Contraction − Churn (+ migração líquida).
	measure 'Net New MRR' = SUM ( fMovimentoMRR[ValorMRR] )
		formatString: "R$" #,0
		displayFolder: 01 Revenue
		lineageTag: 99f3bfcf-b73c-5073-9f93-2f3068405255

	/// Valor assinado do movimento (para gráficos por tipo).
	measure 'MRR Movimentado' = SUM ( fMovimentoMRR[ValorMRR] )
		formatString: "R$" #,0
		displayFolder: 01 Revenue
		lineageTag: 922eff10-e199-52d9-8104-0f7c6436ec08

	/// Deve ser sempre 0: Beginning + movimentos − Ending.
	measure 'Check Reconciliação MRR' = ROUND ( [Beginning MRR] + [Net New MRR] - [Ending MRR], 2 )
		formatString: "R$" #,0.00
		displayFolder: 01 Revenue
		lineageTag: 7f2d8df4-b6e1-52f4-bb16-62a1c21d9346

	/// Annual Recurring Revenue = Ending MRR × 12.
	measure ARR = [Ending MRR] * 12
		formatString: "R$" #,0
		displayFolder: 01 Revenue
		lineageTag: 669c523b-9f44-5c2c-819c-5d50ce167113

	/// Clientes com MRR > 0 no último mês do contexto.
	measure 'Clientes Ativos' =
			VAR _m = MAX ( dCalendario[InicioMes] )
			RETURN
			    CALCULATE ( DISTINCTCOUNT ( fSnapshotMRR[ClienteID] ), REMOVEFILTERS ( dCalendario ), dCalendario[Data] = _m )
		formatString: #,0
		displayFolder: 01 Revenue
		lineageTag: e07f4f43-f189-5c7d-9039-ae53ff894d59

	/// Receita média recorrente por conta.
	measure ARPA = DIVIDE ( [Ending MRR], [Clientes Ativos] )
		formatString: "R$" #,0
		displayFolder: 01 Revenue
		lineageTag: d5d18692-5096-54a2-aa2f-4383cf19c863

	measure 'MRR 12M Antes' =
			VAR _m = MAX ( dCalendario[InicioMes] )
			RETURN
			    CALCULATE ( SUM ( fSnapshotMRR[MRR] ), REMOVEFILTERS ( dCalendario ), dCalendario[Data] = EDATE ( _m, -12 ) )
		formatString: "R$" #,0
		displayFolder: 01 Revenue
		lineageTag: 5d261b66-d956-584b-8e45-f74c2c290b1d

	measure 'MRR Mês Anterior' =
			VAR _m = MAX ( dCalendario[InicioMes] )
			RETURN
			    CALCULATE ( SUM ( fSnapshotMRR[MRR] ), REMOVEFILTERS ( dCalendario ), dCalendario[Data] = EDATE ( _m, -1 ) )
		formatString: "R$" #,0
		displayFolder: 01 Revenue
		lineageTag: 177ab7da-ca19-5b64-bb50-de01c236c498

	measure 'MRR YoY %' = DIVIDE ( [Ending MRR] - [MRR 12M Antes], [MRR 12M Antes] )
		formatString: 0.0%
		displayFolder: 01 Revenue
		lineageTag: 611d4777-629e-51e9-9c1e-6bf6edd0abf2

	measure 'MRR MoM %' = DIVIDE ( [Ending MRR] - [MRR Mês Anterior], [MRR Mês Anterior] )
		formatString: 0.0%
		displayFolder: 01 Revenue
		lineageTag: 56858928-3dfb-5df7-9c06-482c96e4b1b1

	/// Crescimento mensal exibido a partir de jul/24 (meses iniciais partem de base próxima de zero).
	measure 'MRR MoM % Gráfico' = IF ( MAX ( dCalendario[InicioMes] ) >= DATE ( 2024, 7, 1 ), [MRR MoM %] )
		formatString: 0.0%
		displayFolder: 01 Revenue
		lineageTag: e8d62196-35c6-5cd0-af29-5e8b2ce02c49

	/// Crescimento do MRR no período selecionado.
	measure 'MRR Growth %' = DIVIDE ( [Ending MRR] - [Beginning MRR], [Beginning MRR] )
		formatString: 0.0%
		displayFolder: 01 Revenue
		lineageTag: 0b47883e-dd6e-547a-8e1c-6eae902cf4bc

	measure '% MRR do Total' =
			DIVIDE (
			    [Ending MRR],
			    CALCULATE ( [Ending MRR], ALLSELECTED ( dPlano ), ALLSELECTED ( dCanalAquisicao ), ALLSELECTED ( dSegmento ), ALLSELECTED ( dPorte ) )
			)
		formatString: 0.0%
		displayFolder: 01 Revenue
		lineageTag: 7687536b-c6b7-5f3d-b9a9-661f5ee6f9a8

	/// Use com dPlano[Plano] (plano vigente no snapshot).
	measure 'MRR por Plano' = [Ending MRR]
		formatString: "R$" #,0
		displayFolder: 01 Revenue
		lineageTag: e66c4fcc-6483-5be6-a113-5690144766be

	/// Use com dCanalAquisicao[Canal] (canal de aquisição do cliente).
	measure 'MRR por Canal' = [Ending MRR]
		formatString: "R$" #,0
		displayFolder: 01 Revenue
		lineageTag: ed1f4154-3fee-5730-af18-81abe6b3cc5e

	/// Use com dSegmento[Segmento].
	measure 'MRR por Segmento' = [Ending MRR]
		formatString: "R$" #,0
		displayFolder: 01 Revenue
		lineageTag: 68adaaff-cfc1-577e-8227-86485f15f208

	measure 'Clientes Novos' = CALCULATE ( COUNTROWS ( fMovimentoMRR ), fMovimentoMRR[TipoMovimento] = "New" )
		formatString: #,0
		displayFolder: 02 Retention
		lineageTag: 457549f0-bb74-5b84-8bdd-4227da59011a

	measure 'Clientes Cancelados' = CALCULATE ( COUNTROWS ( fMovimentoMRR ), fMovimentoMRR[TipoMovimento] = "Churn" )
		formatString: #,0
		displayFolder: 02 Retention
		lineageTag: 34f75b86-c5be-58fa-959c-b06a2d9a3190

	measure 'Clientes Reativados' = CALCULATE ( COUNTROWS ( fMovimentoMRR ), fMovimentoMRR[TipoMovimento] = "Reactivation" )
		formatString: #,0
		displayFolder: 02 Retention
		lineageTag: e022813e-8994-561b-8323-3d3ab61e29cc

	/// Σ clientes ativos no início de cada mês do contexto (denominador de churn mensal).
	measure 'Clientes Base Mensal' =
			SUMX (
			    VALUES ( dCalendario[InicioMes] ),
			    VAR _m = dCalendario[InicioMes]
			    RETURN
			        CALCULATE ( DISTINCTCOUNT ( fSnapshotMRR[ClienteID] ), REMOVEFILTERS ( dCalendario ), dCalendario[Data] = EDATE ( _m, -1 ) )
			)
		formatString: #,0
		isHidden
		displayFolder: 02 Retention
		lineageTag: 64cf3f22-dd0b-55af-aa9f-8226b7f0cf63

	/// Σ MRR no início de cada mês do contexto.
	measure 'MRR Base Mensal' =
			SUMX (
			    VALUES ( dCalendario[InicioMes] ),
			    VAR _m = dCalendario[InicioMes]
			    RETURN
			        CALCULATE ( SUM ( fSnapshotMRR[MRR] ), REMOVEFILTERS ( dCalendario ), dCalendario[Data] = EDATE ( _m, -1 ) )
			)
		formatString: "R$" #,0
		isHidden
		displayFolder: 02 Retention
		lineageTag: 98777836-f059-505b-ac68-69141986b9a9

	/// Taxa média MENSAL de cancelamento de logos no período.
	measure 'Logo Churn %' = DIVIDE ( [Clientes Cancelados], [Clientes Base Mensal] )
		formatString: 0.00%
		displayFolder: 02 Retention
		lineageTag: 88cdbd14-2834-5594-9ed3-73dd50d4e884

	/// Gross revenue churn médio mensal (churn + contração).
	measure 'Revenue Churn %' = DIVIDE ( [Churned MRR] + [Contraction MRR], [MRR Base Mensal] )
		formatString: 0.00%
		displayFolder: 02 Retention
		lineageTag: 56912eda-e1e6-528e-953a-5d8471c88c9f

	/// Retenção média mensal de logos.
	measure 'Customer Retention %' = IF ( NOT ISBLANK ( [Logo Churn %] ), 1 - [Logo Churn %] )
		formatString: 0.0%
		displayFolder: 02 Retention
		lineageTag: de5ec9eb-a193-5fa1-be3e-4cc3773c2253

	/// Net Revenue Retention 12 meses: MRR atual da base de 12 meses atrás ÷ MRR daquela base (inclui expansão).
	measure 'NRR %' =
			VAR _m = MAX ( dCalendario[InicioMes] )
			VAR _b = EDATE ( _m, -12 )
			VAR _t0 =
			    CALCULATETABLE (
			        SELECTCOLUMNS ( fSnapshotMRR, "ClienteID", fSnapshotMRR[ClienteID], "@v0", fSnapshotMRR[MRR] ),
			        REMOVEFILTERS ( dCalendario ), dCalendario[Data] = _b
			    )
			VAR _t1 =
			    CALCULATETABLE (
			        SELECTCOLUMNS ( fSnapshotMRR, "ClienteID", fSnapshotMRR[ClienteID], "@v1", fSnapshotMRR[MRR] ),
			        REMOVEFILTERS ( dCalendario ), REMOVEFILTERS ( dPlano ), dCalendario[Data] = _m
			    )
			VAR _j = NATURALLEFTOUTERJOIN ( _t0, _t1 )
			VAR _mrr0 = SUMX ( _t0, [@v0] )
			RETURN IF ( _mrr0 > 0, DIVIDE ( SUMX ( _j, [@v1] ), _mrr0 ) )
		formatString: 0.0%
		displayFolder: 02 Retention
		lineageTag: b86716a8-bf5f-5770-9842-ed52763f38c4

	/// Gross Revenue Retention 12 meses (sem expansão, limitado a 100% por conta).
	measure 'GRR %' =
			VAR _m = MAX ( dCalendario[InicioMes] )
			VAR _b = EDATE ( _m, -12 )
			VAR _t0 =
			    CALCULATETABLE (
			        SELECTCOLUMNS ( fSnapshotMRR, "ClienteID", fSnapshotMRR[ClienteID], "@v0", fSnapshotMRR[MRR] ),
			        REMOVEFILTERS ( dCalendario ), dCalendario[Data] = _b
			    )
			VAR _t1 =
			    CALCULATETABLE (
			        SELECTCOLUMNS ( fSnapshotMRR, "ClienteID", fSnapshotMRR[ClienteID], "@v1", fSnapshotMRR[MRR] ),
			        REMOVEFILTERS ( dCalendario ), REMOVEFILTERS ( dPlano ), dCalendario[Data] = _m
			    )
			VAR _j = NATURALLEFTOUTERJOIN ( _t0, _t1 )
			VAR _mrr0 = SUMX ( _t0, [@v0] )
			RETURN IF ( _mrr0 > 0, DIVIDE ( SUMX ( _j, MIN ( [@v0], COALESCE ( [@v1], 0 ) ) ), _mrr0 ) )
		formatString: 0.0%
		displayFolder: 02 Retention
		lineageTag: c21089df-6ef3-5866-b624-3bc19f0dc285

	/// % de logos ativos há 12 meses que continuam ativos.
	measure 'Customer Retention 12M %' =
			VAR _m = MAX ( dCalendario[InicioMes] )
			VAR _b = EDATE ( _m, -12 )
			VAR _t0 =
			    CALCULATETABLE (
			        SELECTCOLUMNS ( fSnapshotMRR, "ClienteID", fSnapshotMRR[ClienteID], "@v0", fSnapshotMRR[MRR] ),
			        REMOVEFILTERS ( dCalendario ), dCalendario[Data] = _b
			    )
			VAR _t1 =
			    CALCULATETABLE (
			        SELECTCOLUMNS ( fSnapshotMRR, "ClienteID", fSnapshotMRR[ClienteID], "@v1", fSnapshotMRR[MRR] ),
			        REMOVEFILTERS ( dCalendario ), REMOVEFILTERS ( dPlano ), dCalendario[Data] = _m
			    )
			VAR _j = NATURALLEFTOUTERJOIN ( _t0, _t1 )
			VAR _mrr0 = SUMX ( _t0, [@v0] )
			RETURN DIVIDE ( COUNTROWS ( FILTER ( _j, NOT ISBLANK ( [@v1] ) ) ), COUNTROWS ( _t0 ) )
		formatString: 0.0%
		displayFolder: 02 Retention
		lineageTag: e6d2eba6-9af1-5e7e-b67a-cabacf5359a2

	measure 'Clientes Iniciais Cohort' = SUM ( fCohortMensal[ClientesIniciais] )
		formatString: #,0
		displayFolder: 02 Retention
		lineageTag: 0374745b-83c2-5ac1-ada3-e63c95610e41

	measure 'Clientes Ativos Cohort' = SUM ( fCohortMensal[ClientesAtivos] )
		formatString: #,0
		displayFolder: 02 Retention
		lineageTag: 2e384d2c-9529-5462-8391-93f21a3d995e

	measure 'Cohort Retention %' = DIVIDE ( [Clientes Ativos Cohort], [Clientes Iniciais Cohort] )
		formatString: 0.0%
		displayFolder: 02 Retention
		lineageTag: acc506ea-6467-5fe0-b828-5f9727944b6e

	/// MRR restante do cohort ÷ MRR inicial (inclui expansão acumulada).
	measure 'Cohort Revenue Retention %' = DIVIDE ( SUM ( fCohortMensal[MRRAtivo] ), SUM ( fCohortMensal[MRRInicial] ) )
		formatString: 0.0%
		displayFolder: 02 Retention
		lineageTag: 661e8f64-f74f-5b7f-b640-0aa49a9830d2

	measure 'Cohort Churn Acumulado %' = IF ( NOT ISBLANK ( [Cohort Retention %] ), 1 - [Cohort Retention %] )
		formatString: 0.0%
		displayFolder: 02 Retention
		lineageTag: 1564624b-0e59-5efa-b7d1-3b8403576a4a

	/// Retenção do cohort limitada a M0–M12 (alimenta o heatmap Deneb).
	measure 'Cohort Retenção Heatmap' = IF ( MAX ( fCohortMensal[IdadeCohort] ) <= 12, [Cohort Retention %] )
		formatString: 0.0%
		isHidden
		displayFolder: 02 Retention
		lineageTag: 9b1906aa-32a5-5d9b-90a3-ea9b2dfc1ccc

	/// Contas ativas com Health Score no último mês.
	measure 'Clientes Monitorados' =
			VAR _m = MAX ( dCalendario[InicioMes] )
			RETURN
			    CALCULATE ( COUNTROWS ( fUsoProduto ), REMOVEFILTERS ( dCalendario ), dCalendario[Data] = _m )
		formatString: #,0
		displayFolder: 02 Retention
		lineageTag: 17f089a2-0551-5f7e-bfcf-cda9813b96a6

	/// Contas nas faixas Risco ou Crítico no último mês do contexto.
	measure 'Clientes em Risco' =
			VAR _m = MAX ( dCalendario[InicioMes] )
			RETURN
			    CALCULATE ( COUNTROWS ( fUsoProduto ), REMOVEFILTERS ( dCalendario ), dCalendario[Data] = _m, fUsoProduto[FaixaHealth] IN { "Risco", "Crítico" } )
		formatString: #,0
		displayFolder: 02 Retention
		lineageTag: 41da1b81-db32-51c1-942a-e5bfb5b0f076

	measure '% Clientes em Risco' = DIVIDE ( [Clientes em Risco], [Clientes Monitorados] )
		formatString: 0.0%
		displayFolder: 02 Retention
		lineageTag: eb2ca1d4-0506-5d97-b12a-6d44a423da85

	measure 'MRR em Risco' =
			VAR _m = MAX ( dCalendario[InicioMes] )
			VAR _risco =
			    CALCULATETABLE ( VALUES ( fUsoProduto[ClienteID] ), REMOVEFILTERS ( dCalendario ), dCalendario[Data] = _m, fUsoProduto[FaixaHealth] IN { "Risco", "Crítico" } )
			RETURN
			    CALCULATE ( SUM ( fSnapshotMRR[MRR] ), REMOVEFILTERS ( dCalendario ), dCalendario[Data] = _m, TREATAS ( _risco, fSnapshotMRR[ClienteID] ) )
		formatString: "R$" #,0
		displayFolder: 02 Retention
		lineageTag: a63448af-c925-58da-a075-e85a347b3b1c

	measure '% da Base (Health)' = DIVIDE ( [Clientes Monitorados], CALCULATE ( [Clientes Monitorados], REMOVEFILTERS ( dFaixaHealth ) ) )
		formatString: 0.0%
		displayFolder: 02 Retention
		lineageTag: 8c870035-254b-527f-a24d-6dab2bde79e0

	measure 'Health Score Médio' =
			VAR _m = MAX ( dCalendario[InicioMes] )
			RETURN
			    CALCULATE ( AVERAGE ( fUsoProduto[HealthScore] ), REMOVEFILTERS ( dCalendario ), dCalendario[Data] = _m )
		formatString: 0.0
		displayFolder: 02 Retention
		lineageTag: da5f9918-3a83-58e4-99fb-ea37cf194b26

	measure 'Clientes com Integração' =
			VAR _m = MAX ( dCalendario[InicioMes] )
			RETURN
			    CALCULATE ( COUNTROWS ( fUsoProduto ), REMOVEFILTERS ( dCalendario ), dCalendario[Data] = _m, fUsoProduto[IntegracoesAtivas] > 0 )
		formatString: #,0
		displayFolder: 02 Retention
		lineageTag: b0e0e314-734a-5a84-a938-4ad6cf10b97f

	measure '% Clientes com Integração' = DIVIDE ( [Clientes com Integração], [Clientes Monitorados] )
		formatString: 0.0%
		displayFolder: 02 Retention
		lineageTag: c79777d7-7d98-5180-92bf-6907be7b3b1d

	/// Média de funcionalidades usadas ÷ 10 funcionalidades disponíveis.
	measure 'Taxa de Adoção' = DIVIDE ( VAR _m = MAX ( dCalendario[InicioMes] ) RETURN     CALCULATE ( AVERAGE ( fUsoProduto[FuncionalidadesUsadas] ), REMOVEFILTERS ( dCalendario ), dCalendario[Data] = _m ), 10 )
		formatString: 0.0%
		displayFolder: 02 Retention
		lineageTag: 9a530f72-ca16-571d-96e4-a15555cfa497

	measure 'Investimento Marketing' = SUM ( fMarketing[Investimento] )
		formatString: "R$" #,0
		displayFolder: 03 Growth
		lineageTag: 197b0c22-7d68-5554-8de1-2f9a4fdd15b4

	measure Visitantes = SUM ( fMarketing[Visitantes] )
		formatString: #,0
		displayFolder: 03 Growth
		lineageTag: 1cebcfac-2078-5ea0-82ff-b09e7ce18208

	measure Leads = COUNTROWS ( fLeads )
		formatString: #,0
		displayFolder: 03 Growth
		lineageTag: a23ca23d-3548-59fb-b4a6-a7d6c17ab640

	measure MQL = CALCULATE ( COUNTROWS ( fLeads ), fLeads[MQL] = "Sim" )
		formatString: #,0
		displayFolder: 03 Growth
		lineageTag: 4270113e-351b-5dc4-b601-4532c63ee582

	measure SQL = CALCULATE ( COUNTROWS ( fLeads ), fLeads[SQL] = "Sim" )
		formatString: #,0
		displayFolder: 03 Growth
		lineageTag: 04152605-057c-524e-afb1-b40ffc6cda7d

	measure Trials = COUNTROWS ( fTrials )
		formatString: #,0
		displayFolder: 03 Growth
		lineageTag: 6e8ef1a4-74dd-577b-a912-c12e9240afff

	measure 'Clientes Convertidos' = CALCULATE ( COUNTROWS ( fTrials ), fTrials[Convertido] = "Sim" )
		formatString: #,0
		displayFolder: 03 Growth
		lineageTag: 17fece00-2d38-5b9b-94d3-5a785c92b064

	measure 'Novos Clientes Adquiridos' = COUNTROWS ( fAquisicao )
		formatString: #,0
		displayFolder: 03 Growth
		lineageTag: 0e42818d-56b6-59dd-8852-525cb72525b1

	measure 'Lead → Trial %' = DIVIDE ( [Trials], [Leads] )
		formatString: 0.0%
		displayFolder: 03 Growth
		lineageTag: f0e61eb9-1dd0-50c5-a3c3-6dbf77de2a97

	measure 'Trial → Paid %' = DIVIDE ( [Clientes Convertidos], [Trials] )
		formatString: 0.0%
		displayFolder: 03 Growth
		lineageTag: 2223b657-6fae-5e5f-877b-3534b6caea20

	measure 'Lead → Cliente %' = DIVIDE ( [Novos Clientes Adquiridos], [Leads] )
		formatString: 0.00%
		displayFolder: 03 Growth
		lineageTag: 1ea4c746-8e91-548f-bb88-c3a8985977cc

	/// Investimento alocado ÷ novos clientes da mesma janela e população (Σ custo alocado = investimento de marketing).
	measure CAC = DIVIDE ( SUM ( fAquisicao[CustoAquisicao] ), [Novos Clientes Adquiridos] )
		formatString: "R$" #,0
		displayFolder: 03 Growth
		lineageTag: 7127730a-a588-53de-907b-94a8ff7845b2

	measure 'ARPA Novos Clientes' = DIVIDE ( SUM ( fAquisicao[MRRInicial] ), [Novos Clientes Adquiridos] )
		formatString: "R$" #,0
		displayFolder: 03 Growth
		lineageTag: f08b6f26-9aa2-542d-92e8-e7b64e6f544f

	/// Premissa documentada de margem bruta SaaS (80%).
	measure 'Margem Bruta Premissa' = 0.80
		formatString: 0.0%
		displayFolder: 03 Growth
		lineageTag: 98d59870-20e4-5cc9-817c-acb303a03942

	/// 1 ÷ churn mensal de logos, limitada a 60 meses (premissa conservadora).
	measure 'Vida Útil Estimada' = IF ( NOT ISBLANK ( [Logo Churn %] ), MIN ( DIVIDE ( 1, [Logo Churn %], 60 ), 60 ) )
		formatString: 0.0
		displayFolder: 03 Growth
		lineageTag: 0c30be12-2545-505b-98d0-b054ce22f4cd

	/// ESTIMATIVA: ARPA × margem bruta (80%) × vida útil (1/churn, máx. 60 meses).
	measure 'LTV Estimado' = [ARPA] * [Margem Bruta Premissa] * [Vida Útil Estimada]
		formatString: "R$" #,0
		displayFolder: 03 Growth
		lineageTag: 88cd4e34-a2bb-5570-8179-ce2a4ce89e8b

	measure LTV:CAC = DIVIDE ( [LTV Estimado], [CAC] )
		formatString: 0.0"x"
		displayFolder: 03 Growth
		lineageTag: 2d63134b-7792-55cf-88ba-5a32b72571c2

	/// Meses de margem bruta do MRR inicial para recuperar o CAC.
	measure 'CAC Payback' = DIVIDE ( [CAC], [ARPA Novos Clientes] * [Margem Bruta Premissa] )
		formatString: 0.0" meses"
		displayFolder: 03 Growth
		lineageTag: e20e1b7f-141d-5d0d-8258-61c791814437

