			            & "<polygon points='4,60 " & _spts & " 156,60' fill='url(#aHTMLCardExpansion)'/>"
			            & "<polyline points='" & _spts & "' fill='none' stroke='url(#lHTMLCardExpansion)' stroke-width='2.6' stroke-linejoin='round' stroke-linecap='round' vector-effect='non-scaling-stroke'/>"
			            & "<circle class='pl' cx='156' cy='" & _sly & "' r='3.2' fill='#FFFFFF'/></svg>"
			    )
			VAR _alert = FALSE ()
