	/// Folha de estilo compartilhada (design system NEXORA) para todos os componentes HTML.
	measure 'HTML CSS' = "<style>html,body{margin:0;padding:0;background:transparent;overflow:hidden}.nx,.nx *{box-sizing:border-box;font-family:'Segoe UI',Inter,Arial,sans-serif}.nx{color:#FFFFFF}@keyframes nxin{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}@keyframes nxglow{0%,100%{box-shadow:0 0 0 0 rgba(0,184,245,.0),inset 0 1px 0 rgba(255,255,255,.08)}50%{box-shadow:0 0 18px 0 rgba(0,184,245,.25),inset 0 1px 0 rgba(255,255,255,.08)}}@keyframes nxpulse{0%,100%{box-shadow:0 0 0 0 rgba(255,96,122,.45)}50%{box-shadow:0 0 0 7px rgba(255,96,122,0)}}@keyframes nxgrow{from{transform:scaleX(0)}to{transform:scaleX(1)}}@keyframes nxdash{from{stroke-dashoffset:400}to{stroke-dashoffset:0}}.card{position:relative;height:100vh;border-radius:18px;padding:16px 18px 12px 18px;overflow:hidden;background:linear-gradient(135deg,rgba(22,120,255,.22) 0%,rgba(103,54,245,.12) 55%,rgba(5,13,32,.30) 100%);border:1px solid rgba(0,184,245,.38);animation:nxin .5s ease both,nxglow 5s ease-in-out 1s infinite}.card:before{content:'';position:absolute;right:-60px;top:-60px;width:180px;height:180px;border-radius:50%;background:radial-gradient(circle,rgba(0,184,245,.22),rgba(0,184,245,0) 70%)}.card.v{border-color:rgba(103,54,245,.55)}.card.v:before{background:radial-gradient(circle,rgba(103,54,245,.30),rgba(103,54,245,0) 70%)}.card.al{border-color:rgba(255,96,122,.65);animation:nxin .5s ease both,nxpulse 2.4s ease-in-out 1s infinite}.hd{display:flex;align-items:center;gap:12px;position:relative}.ic{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,rgba(0,184,245,.28),rgba(103,54,245,.28));border:1px solid rgba(255,255,255,.10)}.ic svg{width:22px;height:22px}.lb{font-size:14px;font-weight:600;color:#DCE6F7;letter-spacing:.01em;white-space:nowrap}.vl{position:relative;font-size:34px;font-weight:700;line-height:1.05;margin:12px 0 6px 2px;letter-spacing:-.01em;white-space:nowrap}.vl small{font-size:16px;font-weight:600;color:#A9BBD8}.dl{position:relative;font-size:13px;font-weight:700;white-space:nowrap}.cmp{position:relative;font-size:11.5px;color:#8FA3C8;margin-top:2px;white-space:nowrap}.up{color:#00D7C0}.dn{color:#FF607A}.nt{color:#A9BBD8}.sp{position:absolute;right:14px;bottom:14px;width:46%;height:44%}.sp polyline{stroke-dasharray:400;animation:nxdash 1.4s ease-out both}.pl{filter:drop-shadow(0 0 4px #00B8F5)}.hdr{padding:4px 0 0 2px}.eb{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:700;letter-spacing:.28em;color:#8FA3C8}.eb span{display:inline-block;width:34px;height:2px;border-radius:2px;background:linear-gradient(90deg,#00B8F5,#6736F5)}.tt{font-size:46px;font-weight:700;line-height:1.08;letter-spacing:-.01em;margin-top:4px;white-space:nowrap}.tt b{font-weight:700;background:linear-gradient(90deg,#00B8F5,#1678FF 45%,#6736F5);-webkit-background-clip:text;background-clip:text;color:transparent}.st{font-size:15px;color:#A9BBD8;margin-top:2px;white-space:nowrap}.chips{display:flex;gap:8px;align-items:center;flex-wrap:nowrap;overflow:hidden;height:100vh}.chip{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 12px;border-radius:13px;white-space:nowrap;background:rgba(12,28,64,.65);border:1px solid rgba(0,184,245,.30);color:#DCE6F7;font-size:11.5px}.chip b{font-size:10px;letter-spacing:.12em;color:#00B8F5;font-weight:700}.chip.on{border-color:rgba(103,54,245,.8);background:rgba(103,54,245,.22)}.tip{padding:14px 16px;height:100vh}.tip h4{margin:0 0 2px 0;font-size:11px;letter-spacing:.2em;color:#00B8F5}.tip h3{margin:0 0 10px 0;font-size:20px;font-weight:700}.tip table{width:100%;border-collapse:collapse}.tip td{font-size:12.5px;padding:4px 0;border-bottom:1px solid rgba(169,187,216,.12);color:#A9BBD8}.tip td+td{text-align:right;color:#fff;font-weight:600}.bar{height:6px;border-radius:3px;background:rgba(169,187,216,.15);margin-top:10px;overflow:hidden}.bar i{display:block;height:6px;border-radius:3px;background:linear-gradient(90deg,#00B8F5,#6736F5);transform-origin:left;animation:nxgrow .8s ease both}</style>"
		isHidden
		displayFolder: 07 SVG & HTML
		lineageTag: 64a134e3-be21-5769-ad9e-9e3ed1e88c6a

	/// Card KPI HTML de [Ending MRR] com variação e sparkline SVG (12 meses).
	measure 'HTML Card MRR' =
			VAR _m = MAX ( dCalendario[InicioMes] )
			VAR _cur = [Ending MRR]
			VAR _base = CALCULATE ( [Ending MRR], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] = EDATE ( _m, -12 ) )
			VAR _lbl = "vs. 12 meses antes (" & FORMAT ( EDATE ( _m, -12 ), "mmm/yy", "pt-BR" ) & ")"
			VAR _v = _cur
			VAR _d = IF ( NOT ISBLANK ( _base ) && _base <> 0, DIVIDE ( _cur - _base, ABS ( _base ) ) )
			VAR _dtxt = FORMAT ( ABS ( _d ), "0.0%", "pt-BR" )
			VAR _cls = IF ( ISBLANK ( _d ) || _d = 0, "nt", IF ( _d > 0, "up", "dn" ) )
			VAR _arrow = IF ( ISBLANK ( _d ), "", IF ( _d >= 0, "▲ ", "▼ " ) )
			VAR _txt = SWITCH ( TRUE (), ISBLANK ( _v ), "–", ABS ( _v ) >= 1e6, "R$ " & FORMAT ( _v / 1e6, "#,0.00", "pt-BR" ) & " mi", ABS ( _v ) >= 1e3, "R$ " & FORMAT ( _v / 1e3, "#,0.0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _v, "#,0", "pt-BR" ) )
			VAR _sm = MAX ( dCalendario[InicioMes] )
			VAR _st =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( dCalendario[InicioMes] ), REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] > EDATE ( _sm, -12 ), dCalendario[InicioMes] <= _sm ),
			            "@v", VAR _mm = dCalendario[InicioMes] RETURN CALCULATE ( [Ending MRR], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] = _mm )
			        ),
			        NOT ISBLANK ( [@v] )
			    )
			VAR _sn = COUNTROWS ( _st )
			VAR _sx0 = MINX ( _st, dCalendario[InicioMes] )
			VAR _sx1 = MAXX ( _st, dCalendario[InicioMes] )
			VAR _sy0 = MINX ( _st, [@v] )
			VAR _sy1 = MAXX ( _st, [@v] )
			VAR _spts =
			    CONCATENATEX (
			        _st,
			        FORMAT ( 4 + DIVIDE ( INT ( dCalendario[InicioMes] - _sx0 ), INT ( _sx1 - _sx0 ), 0 ) * 152, "0.0", "en-US" ) & ","
			            & FORMAT ( 54 - DIVIDE ( [@v] - _sy0, _sy1 - _sy0, 0.5 ) * 46, "0.0", "en-US" ),
			        " ", dCalendario[InicioMes], ASC
			    )
			VAR _sly = FORMAT ( 54 - DIVIDE ( MAXX ( FILTER ( _st, dCalendario[InicioMes] = _sx1 ), [@v] ) - _sy0, _sy1 - _sy0, 0.5 ) * 46, "0.0", "en-US" )
			VAR _spark =
			    IF (
			        _sn >= 2,
			        "<svg class='sp' viewBox='0 0 160 60' preserveAspectRatio='none'><defs><linearGradient id='lHTMLCardMRR' x1='0' x2='1'><stop offset='0' stop-color='#00B8F5'/><stop offset='1' stop-color='#6736F5'/></linearGradient>"
			            & "<linearGradient id='aHTMLCardMRR' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#00B8F5' stop-opacity='.38'/><stop offset='1' stop-color='#00B8F5' stop-opacity='0'/></linearGradient></defs>"
			            & "<polygon points='4,60 " & _spts & " 156,60' fill='url(#aHTMLCardMRR)'/>"
			            & "<polyline points='" & _spts & "' fill='none' stroke='url(#lHTMLCardMRR)' stroke-width='2.6' stroke-linejoin='round' stroke-linecap='round' vector-effect='non-scaling-stroke'/>"
			            & "<circle class='pl' cx='156' cy='" & _sly & "' r='3.2' fill='#FFFFFF'/></svg>"
			    )
			VAR _alert = FALSE ()
			RETURN
