	/// Card KPI HTML de [Churned MRR] com variação e sparkline SVG (12 meses).
	measure 'HTML Card Churned' =
			VAR _mx = MAX ( dCalendario[InicioMes] )
			VAR _mn = MIN ( dCalendario[InicioMes] )
			VAR _nm = DATEDIFF ( _mn, _mx, MONTH ) + 1
			VAR _pi = EDATE ( _mn, - _nm )
			VAR _temPrev = _pi >= DATE ( 2024, 1, 1 )
			VAR _v = [Churned MRR]
			VAR _cur =
			    IF ( _temPrev, _v, CALCULATE ( [Churned MRR], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] > EDATE ( _mx, -12 ), dCalendario[InicioMes] <= _mx ) )
			VAR _base =
			    IF (
			        _temPrev,
			        CALCULATE ( [Churned MRR], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] >= _pi, dCalendario[InicioMes] < _mn ),
			        IF ( EDATE ( _mx, -23 ) >= DATE ( 2024, 1, 1 ), CALCULATE ( [Churned MRR], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] > EDATE ( _mx, -24 ), dCalendario[InicioMes] <= EDATE ( _mx, -12 ) ) )
			    )
			VAR _lbl = IF ( _temPrev, "vs. período anterior equivalente", "últimos 12m vs. 12m anteriores" )
			VAR _d = IF ( NOT ISBLANK ( _base ) && _base <> 0, DIVIDE ( _cur - _base, ABS ( _base ) ) )
			VAR _dtxt = FORMAT ( ABS ( _d ), "0.0%", "pt-BR" )
			VAR _cls = IF ( ISBLANK ( _d ) || _d = 0, "nt", IF ( _d < 0, "up", "dn" ) )
			VAR _arrow = IF ( ISBLANK ( _d ), "", IF ( _d >= 0, "▲ ", "▼ " ) )
			VAR _txt = SWITCH ( TRUE (), ISBLANK ( _v ), "–", ABS ( _v ) >= 1e6, "R$ " & FORMAT ( _v / 1e6, "#,0.00", "pt-BR" ) & " mi", ABS ( _v ) >= 1e3, "R$ " & FORMAT ( _v / 1e3, "#,0.0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _v, "#,0", "pt-BR" ) )
			VAR _sm = MAX ( dCalendario[InicioMes] )
			VAR _st =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( dCalendario[InicioMes] ), REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] > EDATE ( _sm, -12 ), dCalendario[InicioMes] <= _sm ),
			            "@v", VAR _mm = dCalendario[InicioMes] RETURN CALCULATE ( [Churned MRR], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] = _mm )
			        ),
			        NOT ISBLANK ( [@v] )
			    )
			VAR _sn = COUNTROWS ( _st )
			VAR _sx0 = MINX ( _st, dCalendario[InicioMes] )
			VAR _sx1 = MAXX ( _st, dCalendario[InicioMes] )
			VAR _sy0 = MINX ( _st, [@v] )
			VAR _sy1 = MAXX ( _st, [@v] )
			VAR _spts =
			    CONCATENATEX (
			        _st,
			        FORMAT ( 4 + DIVIDE ( INT ( dCalendario[InicioMes] - _sx0 ), INT ( _sx1 - _sx0 ), 0 ) * 152, "0.0", "en-US" ) & ","
			            & FORMAT ( 54 - DIVIDE ( [@v] - _sy0, _sy1 - _sy0, 0.5 ) * 46, "0.0", "en-US" ),
			        " ", dCalendario[InicioMes], ASC
			    )
			VAR _sly = FORMAT ( 54 - DIVIDE ( MAXX ( FILTER ( _st, dCalendario[InicioMes] = _sx1 ), [@v] ) - _sy0, _sy1 - _sy0, 0.5 ) * 46, "0.0", "en-US" )
			VAR _spark =
			    IF (
			        _sn >= 2,
			        "<svg class='sp' viewBox='0 0 160 60' preserveAspectRatio='none'><defs><linearGradient id='lHTMLCardChurned' x1='0' x2='1'><stop offset='0' stop-color='#00B8F5'/><stop offset='1' stop-color='#6736F5'/></linearGradient>"
			            & "<linearGradient id='aHTMLCardChurned' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#00B8F5' stop-opacity='.38'/><stop offset='1' stop-color='#00B8F5' stop-opacity='0'/></linearGradient></defs>"
			            & "<polygon points='4,60 " & _spts & " 156,60' fill='url(#aHTMLCardChurned)'/>"
			            & "<polyline points='" & _spts & "' fill='none' stroke='url(#lHTMLCardChurned)' stroke-width='2.6' stroke-linejoin='round' stroke-linecap='round' vector-effect='non-scaling-stroke'/>"
			            & "<circle class='pl' cx='156' cy='" & _sly & "' r='3.2' fill='#FFFFFF'/></svg>"
			    )
			VAR _alert = FALSE ()
			RETURN
			    [HTML CSS] & "<div class='nx card " & IF ( _alert, " al", "" ) & "'><div class='hd'><div class='ic'><svg viewBox='0 0 24 24' fill='none' stroke='#FFFFFF' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M4 4l16 16M20 9v11H9'/></svg></div><div class='lb'>Churned MRR</div></div>"
			        & "<div class='vl'>" & _txt & "</div>"
			        & "<div class='dl " & _cls & "'>" & IF ( ISBLANK ( _d ), "<span class='nt'>sem base comparável</span>", _arrow & _dtxt ) & "</div>"
			        & "<div class='cmp'>" & IF ( ISBLANK ( _d ), "histórico insuficiente", _lbl ) & "</div>"
			        & _spark & "</div>"
		displayFolder: 07 SVG & HTML
