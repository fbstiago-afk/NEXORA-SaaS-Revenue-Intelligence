	/// Card KPI HTML de [Logo Churn %] com variação e sparkline SVG (12 meses).
	measure 'HTML Card Logo Churn' =
			VAR _mx = MAX ( dCalendario[InicioMes] )
			VAR _mn = MIN ( dCalendario[InicioMes] )
			VAR _nm = DATEDIFF ( _mn, _mx, MONTH ) + 1
			VAR _pi = EDATE ( _mn, - _nm )
			VAR _temPrev = _pi >= DATE ( 2024, 1, 1 )
			VAR _v = [Logo Churn %]
			VAR _cur =
			    IF ( _temPrev, _v, CALCULATE ( [Logo Churn %], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] > EDATE ( _mx, -12 ), dCalendario[InicioMes] <= _mx ) )
			VAR _base =
			    IF (
			        _temPrev,
			        CALCULATE ( [Logo Churn %], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] >= _pi, dCalendario[InicioMes] < _mn ),
			        IF ( EDATE ( _mx, -23 ) >= DATE ( 2024, 1, 1 ), CALCULATE ( [Logo Churn %], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] > EDATE ( _mx, -24 ), dCalendario[InicioMes] <= EDATE ( _mx, -12 ) ) )
			    )
			VAR _lbl = IF ( _temPrev, "vs. período anterior equivalente", "últimos 12m vs. 12m anteriores" )
			VAR _d = IF ( NOT ISBLANK ( _base ) && NOT ISBLANK ( _cur ), ( _cur - _base ) * 100 )
			VAR _dtxt = FORMAT ( ABS ( _d ), "0.0", "pt-BR" ) & " p.p."
			VAR _cls = IF ( ISBLANK ( _d ) || _d = 0, "nt", IF ( _d < 0, "up", "dn" ) )
			VAR _arrow = IF ( ISBLANK ( _d ), "", IF ( _d >= 0, "▲ ", "▼ " ) )
			VAR _txt = IF ( ISBLANK ( _v ), "–", FORMAT ( _v, "0.00%", "pt-BR" ) )
			VAR _sm = MAX ( dCalendario[InicioMes] )
			VAR _st =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( dCalendario[InicioMes] ), REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] > EDATE ( _sm, -12 ), dCalendario[InicioMes] <= _sm ),
			            "@v", VAR _mm = dCalendario[InicioMes] RETURN CALCULATE ( [Logo Churn %], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] = _mm )
			        ),
			        NOT ISBLANK ( [@v] )
			    )
			VAR _sn = COUNTROWS ( _st )
			VAR _sx0 = MINX ( _st, dCalendario[InicioMes] )
			VAR _sx1 = MAXX ( _st, dCalendario[InicioMes] )
			VAR _sy0 = MINX ( _st, [@v] )
			VAR _sy1 = MAXX ( _st, [@v] )
			VAR _spts =
			    CONCATENATEX (
			        _st,
			        FORMAT ( 4 + DIVIDE ( INT ( dCalendario[InicioMes] - _sx0 ), INT ( _sx1 - _sx0 ), 0 ) * 152, "0.0", "en-US" ) & ","
			            & FORMAT ( 54 - DIVIDE ( [@v] - _sy0, _sy1 - _sy0, 0.5 ) * 46, "0.0", "en-US" ),
			        " ", dCalendario[InicioMes], ASC
			    )
			VAR _sly = FORMAT ( 54 - DIVIDE ( MAXX ( FILTER ( _st, dCalendario[InicioMes] = _sx1 ), [@v] ) - _sy0, _sy1 - _sy0, 0.5 ) * 46, "0.0", "en-US" )
			VAR _spark =
			    IF (
			        _sn >= 2,
			        "<svg class='sp' viewBox='0 0 160 60' preserveAspectRatio='none'><defs><linearGradient id='lHTMLCardLogoChurn' x1='0' x2='1'><stop offset='0' stop-color='#00B8F5'/><stop offset='1' stop-color='#6736F5'/></linearGradient>"
			            & "<linearGradient id='aHTMLCardLogoChurn' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#00B8F5' stop-opacity='.38'/><stop offset='1' stop-color='#00B8F5' stop-opacity='0'/></linearGradient></defs>"
			            & "<polygon points='4,60 " & _spts & " 156,60' fill='url(#aHTMLCardLogoChurn)'/>"
			            & "<polyline points='" & _spts & "' fill='none' stroke='url(#lHTMLCardLogoChurn)' stroke-width='2.6' stroke-linejoin='round' stroke-linecap='round' vector-effect='non-scaling-stroke'/>"
			            & "<circle class='pl' cx='156' cy='" & _sly & "' r='3.2' fill='#FFFFFF'/></svg>"
			    )
			VAR _alert = _v >= 0.03
			RETURN
			    [HTML CSS] & "<div class='nx card " & IF ( _alert, " al", "" ) & "'><div class='hd'><div class='ic'><svg viewBox='0 0 24 24' fill='none' stroke='#FFFFFF' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M5 19 19 5M7.5 7.5h.01M16.5 16.5h.01'/><circle cx='7' cy='7' r='2.5'/><circle cx='17' cy='17' r='2.5'/></svg></div><div class='lb'>Logo Churn (média mensal)</div></div>"
			        & "<div class='vl'>" & _txt & "</div>"
			        & "<div class='dl " & _cls & "'>" & IF ( ISBLANK ( _d ), "<span class='nt'>sem base comparável</span>", _arrow & _dtxt ) & "</div>"
			        & "<div class='cmp'>" & IF ( ISBLANK ( _d ), "histórico insuficiente", _lbl ) & "</div>"
			        & _spark & "</div>"
		displayFolder: 07 SVG & HTML
		lineageTag: 9a125b4d-7784-5d78-8caa-d6fcdc2f1595

	/// Card KPI HTML de [NRR %] com variação e sparkline SVG (12 meses).
	measure 'HTML Card NRR R' =
			VAR _m = MAX ( dCalendario[InicioMes] )
			VAR _cur = [NRR %]
			VAR _base = CALCULATE ( [NRR %], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] = EDATE ( _m, -12 ) )
			VAR _lbl = "vs. 12 meses antes (" & FORMAT ( EDATE ( _m, -12 ), "mmm/yy", "pt-BR" ) & ")"
			VAR _v = _cur
			VAR _d = IF ( NOT ISBLANK ( _base ) && NOT ISBLANK ( _cur ), ( _cur - _base ) * 100 )
			VAR _dtxt = FORMAT ( ABS ( _d ), "0.0", "pt-BR" ) & " p.p."
			VAR _cls = IF ( ISBLANK ( _d ) || _d = 0, "nt", IF ( _d > 0, "up", "dn" ) )
			VAR _arrow = IF ( ISBLANK ( _d ), "", IF ( _d >= 0, "▲ ", "▼ " ) )
			VAR _txt = IF ( ISBLANK ( _v ), "–", FORMAT ( _v, "0.0%", "pt-BR" ) )
			VAR _sm = MAX ( dCalendario[InicioMes] )
			VAR _st =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( dCalendario[InicioMes] ), REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] > EDATE ( _sm, -12 ), dCalendario[InicioMes] <= _sm ),
			            "@v", VAR _mm = dCalendario[InicioMes] RETURN CALCULATE ( [NRR %], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] = _mm )
			        ),
			        NOT ISBLANK ( [@v] )
			    )
			VAR _sn = COUNTROWS ( _st )
			VAR _sx0 = MINX ( _st, dCalendario[InicioMes] )
			VAR _sx1 = MAXX ( _st, dCalendario[InicioMes] )
			VAR _sy0 = MINX ( _st, [@v] )
			VAR _sy1 = MAXX ( _st, [@v] )
			VAR _spts =
			    CONCATENATEX (
			        _st,
			        FORMAT ( 4 + DIVIDE ( INT ( dCalendario[InicioMes] - _sx0 ), INT ( _sx1 - _sx0 ), 0 ) * 152, "0.0", "en-US" ) & ","
			            & FORMAT ( 54 - DIVIDE ( [@v] - _sy0, _sy1 - _sy0, 0.5 ) * 46, "0.0", "en-US" ),
			        " ", dCalendario[InicioMes], ASC
			    )
			VAR _sly = FORMAT ( 54 - DIVIDE ( MAXX ( FILTER ( _st, dCalendario[InicioMes] = _sx1 ), [@v] ) - _sy0, _sy1 - _sy0, 0.5 ) * 46, "0.0", "en-US" )
			VAR _spark =
			    IF (
			        _sn >= 2,
			        "<svg class='sp' viewBox='0 0 160 60' preserveAspectRatio='none'><defs><linearGradient id='lNrrR' x1='0' x2='1'><stop offset='0' stop-color='#00B8F5'/><stop offset='1' stop-color='#6736F5'/></linearGradient>"
			            & "<linearGradient id='aNrrR' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#00B8F5' stop-opacity='.38'/><stop offset='1' stop-color='#00B8F5' stop-opacity='0'/></linearGradient></defs>"
			            & "<polygon points='4,60 " & _spts & " 156,60' fill='url(#aNrrR)'/>"
			            & "<polyline points='" & _spts & "' fill='none' stroke='url(#lNrrR)' stroke-width='2.6' stroke-linejoin='round' stroke-linecap='round' vector-effect='non-scaling-stroke'/>"
			            & "<circle class='pl' cx='156' cy='" & _sly & "' r='3.2' fill='#FFFFFF'/></svg>"
			    )
			VAR _alert = FALSE ()
			RETURN
			    [HTML CSS] & "<div class='nx card v" & IF ( _alert, " al", "" ) & "'><div class='hd'><div class='ic'><svg viewBox='0 0 24 24' fill='none' stroke='#FFFFFF' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3a9 9 0 1 0 9 9M21 3v6h-6M21 9l-6 6-3-3-5 5'/></svg></div><div class='lb'>NRR (12 meses)</div></div>"
			        & "<div class='vl'>" & _txt & "</div>"
			        & "<div class='dl " & _cls & "'>" & IF ( ISBLANK ( _d ), "<span class='nt'>sem base comparável</span>", _arrow & _dtxt ) & "</div>"
			        & "<div class='cmp'>" & IF ( ISBLANK ( _d ), "histórico insuficiente", _lbl ) & "</div>"
			        & _spark & "</div>"
		displayFolder: 07 SVG & HTML
		lineageTag: 75fbe05a-420b-5784-af51-f5bada1adb9e

	/// Card KPI HTML de [Clientes em Risco] com variação e sparkline SVG (12 meses).
	measure 'HTML Card Risco' =
			VAR _m = MAX ( dCalendario[InicioMes] )
			VAR _cur = [Clientes em Risco]
			VAR _base = CALCULATE ( [Clientes em Risco], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] = EDATE ( _m, -12 ) )
			VAR _lbl = "vs. 12 meses antes (" & FORMAT ( EDATE ( _m, -12 ), "mmm/yy", "pt-BR" ) & ")"
			VAR _v = _cur
			VAR _d = IF ( NOT ISBLANK ( _base ) && _base <> 0, DIVIDE ( _cur - _base, ABS ( _base ) ) )
			VAR _dtxt = FORMAT ( ABS ( _d ), "0.0%", "pt-BR" )
			VAR _cls = IF ( ISBLANK ( _d ) || _d = 0, "nt", IF ( _d < 0, "up", "dn" ) )
			VAR _arrow = IF ( ISBLANK ( _d ), "", IF ( _d >= 0, "▲ ", "▼ " ) )
			VAR _txt = IF ( ISBLANK ( _v ), "–", FORMAT ( _v, "#,0", "pt-BR" ) )
			VAR _sm = MAX ( dCalendario[InicioMes] )
			VAR _st =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( dCalendario[InicioMes] ), REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] > EDATE ( _sm, -12 ), dCalendario[InicioMes] <= _sm ),
			            "@v", VAR _mm = dCalendario[InicioMes] RETURN CALCULATE ( [Clientes em Risco], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] = _mm )
			        ),
			        NOT ISBLANK ( [@v] )
			    )
			VAR _sn = COUNTROWS ( _st )
			VAR _sx0 = MINX ( _st, dCalendario[InicioMes] )
			VAR _sx1 = MAXX ( _st, dCalendario[InicioMes] )
			VAR _sy0 = MINX ( _st, [@v] )
			VAR _sy1 = MAXX ( _st, [@v] )
			VAR _spts =
			    CONCATENATEX (
			        _st,
			        FORMAT ( 4 + DIVIDE ( INT ( dCalendario[InicioMes] - _sx0 ), INT ( _sx1 - _sx0 ), 0 ) * 152, "0.0", "en-US" ) & ","
			            & FORMAT ( 54 - DIVIDE ( [@v] - _sy0, _sy1 - _sy0, 0.5 ) * 46, "0.0", "en-US" ),
			        " ", dCalendario[InicioMes], ASC
			    )
			VAR _sly = FORMAT ( 54 - DIVIDE ( MAXX ( FILTER ( _st, dCalendario[InicioMes] = _sx1 ), [@v] ) - _sy0, _sy1 - _sy0, 0.5 ) * 46, "0.0", "en-US" )
			VAR _spark =
			    IF (
			        _sn >= 2,
			        "<svg class='sp' viewBox='0 0 160 60' preserveAspectRatio='none'><defs><linearGradient id='lHTMLCardRisco' x1='0' x2='1'><stop offset='0' stop-color='#00B8F5'/><stop offset='1' stop-color='#6736F5'/></linearGradient>"
			            & "<linearGradient id='aHTMLCardRisco' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#00B8F5' stop-opacity='.38'/><stop offset='1' stop-color='#00B8F5' stop-opacity='0'/></linearGradient></defs>"
			            & "<polygon points='4,60 " & _spts & " 156,60' fill='url(#aHTMLCardRisco)'/>"
			            & "<polyline points='" & _spts & "' fill='none' stroke='url(#lHTMLCardRisco)' stroke-width='2.6' stroke-linejoin='round' stroke-linecap='round' vector-effect='non-scaling-stroke'/>"
			            & "<circle class='pl' cx='156' cy='" & _sly & "' r='3.2' fill='#FFFFFF'/></svg>"
			    )
			VAR _alert = DIVIDE ( _v, [Clientes Monitorados] ) >= 0.15
			RETURN
			    [HTML CSS] & "<div class='nx card " & IF ( _alert, " al", "" ) & "'><div class='hd'><div class='ic'><svg viewBox='0 0 24 24' fill='none' stroke='#FFFFFF' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3 2 20h20L12 3zM12 10v4M12 17v.5'/></svg></div><div class='lb'>Clientes em Risco</div></div>"
			        & "<div class='vl'>" & _txt & "</div>"
			        & "<div class='dl " & _cls & "'>" & IF ( ISBLANK ( _d ), "<span class='nt'>sem base comparável</span>", _arrow & _dtxt ) & "</div>"
			        & "<div class='cmp'>" & IF ( ISBLANK ( _d ), "histórico insuficiente", _lbl ) & "</div>"
			        & _spark & "</div>"
		displayFolder: 07 SVG & HTML
		lineageTag: 60bdd491-037f-569e-a2d6-60866ce9eda6

	/// Card KPI HTML de [CAC] com variação e sparkline SVG (12 meses).
	measure 'HTML Card CAC' =
			VAR _mx = MAX ( dCalendario[InicioMes] )
			VAR _mn = MIN ( dCalendario[InicioMes] )
			VAR _nm = DATEDIFF ( _mn, _mx, MONTH ) + 1
			VAR _pi = EDATE ( _mn, - _nm )
			VAR _temPrev = _pi >= DATE ( 2024, 1, 1 )
			VAR _v = [CAC]
			VAR _cur =
			    IF ( _temPrev, _v, CALCULATE ( [CAC], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] > EDATE ( _mx, -12 ), dCalendario[InicioMes] <= _mx ) )
			VAR _base =
			    IF (
			        _temPrev,
			        CALCULATE ( [CAC], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] >= _pi, dCalendario[InicioMes] < _mn ),
			        IF ( EDATE ( _mx, -23 ) >= DATE ( 2024, 1, 1 ), CALCULATE ( [CAC], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] > EDATE ( _mx, -24 ), dCalendario[InicioMes] <= EDATE ( _mx, -12 ) ) )
			    )
			VAR _lbl = IF ( _temPrev, "vs. período anterior equivalente", "últimos 12m vs. 12m anteriores" )
			VAR _d = IF ( NOT ISBLANK ( _base ) && _base <> 0, DIVIDE ( _cur - _base, ABS ( _base ) ) )
			VAR _dtxt = FORMAT ( ABS ( _d ), "0.0%", "pt-BR" )
			VAR _cls = IF ( ISBLANK ( _d ) || _d = 0, "nt", IF ( _d < 0, "up", "dn" ) )
			VAR _arrow = IF ( ISBLANK ( _d ), "", IF ( _d >= 0, "▲ ", "▼ " ) )
			VAR _txt = SWITCH ( TRUE (), ISBLANK ( _v ), "–", ABS ( _v ) >= 1e6, "R$ " & FORMAT ( _v / 1e6, "#,0.00", "pt-BR" ) & " mi", ABS ( _v ) >= 1e3, "R$ " & FORMAT ( _v / 1e3, "#,0.0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _v, "#,0", "pt-BR" ) )
			VAR _sm = MAX ( dCalendario[InicioMes] )
			VAR _st =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( dCalendario[InicioMes] ), REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] > EDATE ( _sm, -12 ), dCalendario[InicioMes] <= _sm ),
			            "@v", VAR _mm = dCalendario[InicioMes] RETURN CALCULATE ( [CAC], REMOVEFILTERS ( dCalendario ), dCalendario[InicioMes] = _mm )
			        ),
			        NOT ISBLANK ( [@v] )
			    )
			VAR _sn = COUNTROWS ( _st )
			VAR _sx0 = MINX ( _st, dCalendario[InicioMes] )
			VAR _sx1 = MAXX ( _st, dCalendario[InicioMes] )
			VAR _sy0 = MINX ( _st, [@v] )
			VAR _sy1 = MAXX ( _st, [@v] )
			VAR _spts =
			    CONCATENATEX (
			        _st,
			        FORMAT ( 4 + DIVIDE ( INT ( dCalendario[InicioMes] - _sx0 ), INT ( _sx1 - _sx0 ), 0 ) * 152, "0.0", "en-US" ) & ","
			            & FORMAT ( 54 - DIVIDE ( [@v] - _sy0, _sy1 - _sy0, 0.5 ) * 46, "0.0", "en-US" ),
			        " ", dCalendario[InicioMes], ASC
			    )
			VAR _sly = FORMAT ( 54 - DIVIDE ( MAXX ( FILTER ( _st, dCalendario[InicioMes] = _sx1 ), [@v] ) - _sy0, _sy1 - _sy0, 0.5 ) * 46, "0.0", "en-US" )
			VAR _spark =
			    IF (
			        _sn >= 2,
			        "<svg class='sp' viewBox='0 0 160 60' preserveAspectRatio='none'><defs><linearGradient id='lHTMLCardCAC' x1='0' x2='1'><stop offset='0' stop-color='#00B8F5'/><stop offset='1' stop-color='#6736F5'/></linearGradient>"
			            & "<linearGradient id='aHTMLCardCAC' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#00B8F5' stop-opacity='.38'/><stop offset='1' stop-color='#00B8F5' stop-opacity='0'/></linearGradient></defs>"
			            & "<polygon points='4,60 " & _spts & " 156,60' fill='url(#aHTMLCardCAC)'/>"
			            & "<polyline points='" & _spts & "' fill='none' stroke='url(#lHTMLCardCAC)' stroke-width='2.6' stroke-linejoin='round' stroke-linecap='round' vector-effect='non-scaling-stroke'/>"
			            & "<circle class='pl' cx='156' cy='" & _sly & "' r='3.2' fill='#FFFFFF'/></svg>"
			    )
			VAR _alert = FALSE ()
			RETURN
			    [HTML CSS] & "<div class='nx card " & IF ( _alert, " al", "" ) & "'><div class='hd'><div class='ic'><svg viewBox='0 0 24 24' fill='none' stroke='#FFFFFF' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><circle cx='12' cy='12' r='5'/><circle cx='12' cy='12' r='1.5'/></svg></div><div class='lb'>CAC</div></div>"
			        & "<div class='vl'>" & _txt & "</div>"
			        & "<div class='dl " & _cls & "'>" & IF ( ISBLANK ( _d ), "<span class='nt'>sem base comparável</span>", _arrow & _dtxt ) & "</div>"
			        & "<div class='cmp'>" & IF ( ISBLANK ( _d ), "histórico insuficiente", _lbl ) & "</div>"
			        & _spark & "</div>"
		displayFolder: 07 SVG & HTML
		lineageTag: ee526e96-73ee-5724-8539-fa554ee4e1d4

