	partition dCalendario = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(PastaDados & "dCalendario.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
					Colunas = Table.SelectColumns(Cabecalho, {"Data", "Ano", "MesNum", "MesNome", "MesAbrev", "AnoMes", "MesAno", "Trimestre", "AnoTrimestre", "InicioMes", "IndiceMes", "FaseNegocio", "DiaSemana"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"Data", type date}, {"Ano", Int64.Type}, {"MesNum", Int64.Type}, {"MesNome", type text}, {"MesAbrev", type text}, {"AnoMes", Int64.Type}, {"MesAno", type text}, {"Trimestre", type text}, {"AnoTrimestre", type text}, {"InicioMes", type date}, {"IndiceMes", Int64.Type}, {"FaseNegocio", type text}, {"DiaSemana", Int64.Type}}, "en-US")
				in
					Tipos

	annotation PBI_ResultType = Table

