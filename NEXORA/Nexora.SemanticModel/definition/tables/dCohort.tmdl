/// Dimensão de cohort (mês de aquisição). Conecta dCliente e fCohortMensal.
table dCohort
	lineageTag: 84df0e50-ef92-5fff-a867-7429ddfcaeab

	column CohortMes
		dataType: dateTime
		isKey
		formatString: dd/MM/yyyy
		lineageTag: 177b30c6-5d22-5e0b-8ba2-5560d87a4dce
		summarizeBy: none
		sourceColumn: CohortMes

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Cohort
		dataType: string
		lineageTag: b4cba4a0-6470-56ff-af82-cae69190d020
		summarizeBy: none
		sourceColumn: Cohort
		sortByColumn: CohortIdx

		annotation SummarizationSetBy = Automatic

	column CohortIdx
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 71644957-9ace-55d1-a883-dcddb56f5ea5
		summarizeBy: none
		sourceColumn: CohortIdx

		annotation SummarizationSetBy = Automatic

	column CohortAno
		dataType: int64
		formatString: 0
		lineageTag: bd8ef69f-8593-5ad3-9b95-1e8d04d6513c
		summarizeBy: none
		sourceColumn: CohortAno

		annotation SummarizationSetBy = Automatic

	partition dCohort = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(PastaDados & "dCliente.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
					Colunas = Table.SelectColumns(Cabecalho, {"CohortMes"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"CohortMes", type date}}, "en-US"),
					Distintos = Table.Distinct(Tipos),
					Rotulo = Table.AddColumn(Distintos, "Cohort", each Text.Lower(Date.ToText([CohortMes], "MMM", "pt-BR")) & "/" & Date.ToText([CohortMes], "yy"), type text),
					Idx = Table.AddColumn(Rotulo, "CohortIdx", each Date.Year([CohortMes]) * 100 + Date.Month([CohortMes]), Int64.Type),
					Ano = Table.AddColumn(Idx, "CohortAno", each Date.Year([CohortMes]), Int64.Type),
					Ordenado = Table.Sort(Ano, {{"CohortMes", Order.Ascending}})
				in
					Ordenado

	annotation PBI_ResultType = Table

