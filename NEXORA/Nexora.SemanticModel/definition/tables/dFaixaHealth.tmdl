	partition dFaixaHealth = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(PastaDados & "dFaixaHealth.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
					Colunas = Table.SelectColumns(Cabecalho, {"FaixaHealth", "OrdemFaixa", "LimiteInferior", "CorFaixa"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"FaixaHealth", type text}, {"OrdemFaixa", Int64.Type}, {"LimiteInferior", Int64.Type}, {"CorFaixa", type text}}, "en-US")
				in
					Tipos

	annotation PBI_ResultType = Table

