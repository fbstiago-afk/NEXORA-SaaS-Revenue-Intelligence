/// Faixas do Health Score (Saudável ≥75, Atenção 55–74, Risco 35–54, Crítico <35).
table dFaixaHealth
	lineageTag: 07241be4-a69f-5655-aa98-0cd1c8910abf

	column FaixaHealth
		dataType: string
		isKey
		lineageTag: c1d65e2d-3ca7-574a-8504-20886135b478
		summarizeBy: none
		sourceColumn: FaixaHealth
		sortByColumn: OrdemFaixa

		annotation SummarizationSetBy = Automatic

	column OrdemFaixa
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d002eaa6-3701-54c5-98b2-1d1e53257c63
		summarizeBy: none
		sourceColumn: OrdemFaixa

		annotation SummarizationSetBy = Automatic

	column LimiteInferior
		dataType: int64
		formatString: 0
		lineageTag: d34019c6-33b5-5087-8197-bb7f14c9f3b2
		summarizeBy: none
		sourceColumn: LimiteInferior

		annotation SummarizationSetBy = Automatic

	column CorFaixa
		dataType: string
