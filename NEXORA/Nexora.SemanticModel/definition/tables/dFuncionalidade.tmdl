/// Funcionalidades do produto.
table dFuncionalidade
	lineageTag: 1c162927-f30f-5d50-bdd1-cc6b19d17d72

	column FuncionalidadeID
		dataType: int64
		isKey
		formatString: 0
		lineageTag: de8646e1-26d6-573a-ab2e-115a72e662cf
		summarizeBy: none
		sourceColumn: FuncionalidadeID

		annotation SummarizationSetBy = Automatic

	column Funcionalidade
		dataType: string
		lineageTag: faf58677-b29f-5c70-b96c-4cdd3442e2e2
		summarizeBy: none
		sourceColumn: Funcionalidade

		annotation SummarizationSetBy = Automatic

	column CategoriaFuncionalidade
		dataType: string
		lineageTag: 4661dc5a-17c1-550c-b2b8-679d72ed9850
		summarizeBy: none
		sourceColumn: CategoriaFuncionalidade

		annotation SummarizationSetBy = Automatic

	partition dFuncionalidade = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(PastaDados & "dFuncionalidade.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
					Colunas = Table.SelectColumns(Cabecalho, {"FuncionalidadeID", "Funcionalidade", "CategoriaFuncionalidade"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"FuncionalidadeID", Int64.Type}, {"Funcionalidade", type text}, {"CategoriaFuncionalidade", type text}}, "en-US")
				in
					Tipos

	annotation PBI_ResultType = Table

