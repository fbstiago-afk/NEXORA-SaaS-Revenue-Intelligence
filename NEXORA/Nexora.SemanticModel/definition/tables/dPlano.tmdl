	partition dPlano = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(PastaDados & "dPlano.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
					Colunas = Table.SelectColumns(Cabecalho, {"PlanoID", "Plano", "OrdemPlano", "PrecoBaseMensal", "UsuariosInclusos", "PrecoUsuarioExtra", "Posicionamento", "CorPlano"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"PlanoID", Int64.Type}, {"Plano", type text}, {"OrdemPlano", Int64.Type}, {"PrecoBaseMensal", type number}, {"UsuariosInclusos", Int64.Type}, {"PrecoUsuarioExtra", type number}, {"Posicionamento", type text}, {"CorPlano", type text}}, "en-US")
				in
					Tipos

	annotation PBI_ResultType = Table

