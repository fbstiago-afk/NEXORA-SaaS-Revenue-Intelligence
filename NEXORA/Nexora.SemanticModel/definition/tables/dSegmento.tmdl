/// Segmentos de mercado.
table dSegmento
	lineageTag: 423a33ae-2127-52eb-a891-97b60ddcc089

	column SegmentoID
		dataType: int64
		isKey
		formatString: 0
		lineageTag: 982bb37f-661f-560d-9ff6-f342d4c73527
		summarizeBy: none
		sourceColumn: SegmentoID

		annotation SummarizationSetBy = Automatic

	column Segmento
		dataType: string
		lineageTag: 56eaf430-5127-5ba6-8cb3-f6a73b356cc0
		summarizeBy: none
		sourceColumn: Segmento

		annotation SummarizationSetBy = Automatic

	partition dSegmento = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(PastaDados & "dSegmento.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
					Colunas = Table.SelectColumns(Cabecalho, {"SegmentoID", "Segmento"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"SegmentoID", Int64.Type}, {"Segmento", type text}}, "en-US")
				in
					Tipos

	annotation PBI_ResultType = Table

