/// Usuários licenciados das contas clientes.
table dUsuario
	lineageTag: ad598e98-4b9b-5e77-a5b3-306047f5523b

	column UsuarioID
		dataType: int64
		isKey
		formatString: 0
		lineageTag: 2b94e4d5-a95c-5dfd-9f24-678dcdba16f7
		summarizeBy: none
		sourceColumn: UsuarioID

		annotation SummarizationSetBy = Automatic

	column ClienteID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 21c44d68-3bac-5626-9b38-98ec4adae977
		summarizeBy: none
		sourceColumn: ClienteID

		annotation SummarizationSetBy = Automatic

	column Perfil
		dataType: string
		lineageTag: 142d8681-f7be-50b0-826b-473c39eccb58
		summarizeBy: none
		sourceColumn: Perfil

		annotation SummarizationSetBy = Automatic

	column DataCriacao
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: a6701633-70ba-571e-978b-722f41cace92
		summarizeBy: none
		sourceColumn: DataCriacao

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column StatusUsuario
		dataType: string
		lineageTag: bd24a1c7-6f79-59d7-9699-d7f4af6382e1
		summarizeBy: none
		sourceColumn: StatusUsuario

		annotation SummarizationSetBy = Automatic

	partition dUsuario = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(PastaDados & "dUsuario.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
					Colunas = Table.SelectColumns(Cabecalho, {"UsuarioID", "ClienteID", "Perfil", "DataCriacao", "StatusUsuario"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"UsuarioID", Int64.Type}, {"ClienteID", Int64.Type}, {"Perfil", type text}, {"DataCriacao", type date}, {"StatusUsuario", type text}}, "en-US")
				in
					Tipos

	annotation PBI_ResultType = Table

