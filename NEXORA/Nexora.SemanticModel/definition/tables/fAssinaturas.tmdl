					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
					Colunas = Table.SelectColumns(Cabecalho, {"AssinaturaID", "ClienteID", "PlanoID", "TipoCobranca", "DataInicio", "DataFim", "StatusAssinatura", "TipoAbertura", "MRRInicial", "PrazoMeses", "ValorContrato", "UsuariosContratados", "MotivoEncerramento"}),
