	partition fCohortMensal = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(PastaDados & "fCohortMensal.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
					Colunas = Table.SelectColumns(Cabecalho, {"CohortRowID", "CohortMes", "IdadeCohort", "CanalID", "PlanoEntradaID", "SegmentoID", "PorteID", "ClientesIniciais", "ClientesAtivos", "MRRInicial", "MRRAtivo"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"CohortRowID", Int64.Type}, {"CohortMes", type date}, {"IdadeCohort", Int64.Type}, {"CanalID", Int64.Type}, {"PlanoEntradaID", Int64.Type}, {"SegmentoID", Int64.Type}, {"PorteID", Int64.Type}, {"ClientesIniciais", Int64.Type}, {"ClientesAtivos", Int64.Type}, {"MRRInicial", type number}, {"MRRAtivo", type number}}, "en-US")
				in
					Tipos

	annotation PBI_ResultType = Table

