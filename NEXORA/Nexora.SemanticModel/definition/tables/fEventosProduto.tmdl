	partition fEventosProduto = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(PastaDados & "fEventosProduto.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
					Colunas = Table.SelectColumns(Cabecalho, {"EventoID", "ClienteID", "DataMes", "FuncionalidadeID", "Eventos", "UsuariosUnicos"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"EventoID", Int64.Type}, {"ClienteID", Int64.Type}, {"DataMes", type date}, {"FuncionalidadeID", Int64.Type}, {"Eventos", Int64.Type}, {"UsuariosUnicos", Int64.Type}}, "en-US")
				in
					Tipos

	annotation PBI_ResultType = Table

