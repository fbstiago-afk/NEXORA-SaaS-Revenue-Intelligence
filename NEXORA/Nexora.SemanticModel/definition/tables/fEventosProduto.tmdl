/// Grão: cliente × mês × funcionalidade.
table fEventosProduto
	lineageTag: 1221679e-1d07-58af-8dfd-af83271c933d

	column EventoID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 78932131-c839-501a-abfa-858fd971b160
		summarizeBy: none
		sourceColumn: EventoID

		annotation SummarizationSetBy = Automatic

	column ClienteID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 79ec5712-a98e-518c-8330-20d0de0076de
		summarizeBy: none
		sourceColumn: ClienteID

		annotation SummarizationSetBy = Automatic

	column DataMes
		dataType: dateTime
		isHidden
		formatString: dd/MM/yyyy
		lineageTag: cddaa469-3889-5039-9ebe-4f1078869b8f
		summarizeBy: none
		sourceColumn: DataMes

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column FuncionalidadeID
		dataType: int64
		isHidden
		formatString: 0
