	partition fFinanceiro = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(PastaDados & "fFinanceiro.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
					Colunas = Table.SelectColumns(Cabecalho, {"FaturaID", "ClienteID", "DataEmissao", "DataVencimento", "DataPagamento", "TipoFatura", "TipoCobranca", "ValorBruto", "Desconto", "ValorLiquido", "ValorPago", "ValorEstornado", "ValorRecebido", "StatusPagamento", "DiasAtraso"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"FaturaID", Int64.Type}, {"ClienteID", Int64.Type}, {"DataEmissao", type date}, {"DataVencimento", type date}, {"DataPagamento", type date}, {"TipoFatura", type text}, {"TipoCobranca", type text}, {"ValorBruto", type number}, {"Desconto", type number}, {"ValorLiquido", type number}, {"ValorPago", type number}, {"ValorEstornado", type number}, {"ValorRecebido", type number}, {"StatusPagamento", type text}, {"DiasAtraso", Int64.Type}}, "en-US")
				in
					Tipos

	annotation PBI_ResultType = Table

