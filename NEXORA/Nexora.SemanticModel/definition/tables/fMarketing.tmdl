/// Grão: canal × mês. Investimento e tráfego.
table fMarketing
	lineageTag: 481ad94e-7611-5825-9eea-d4c0c2811019

	column MarketingID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 65ba45ac-1834-53de-9ae6-e40e83626cb5
		summarizeBy: none
		sourceColumn: MarketingID

		annotation SummarizationSetBy = Automatic

	column CanalID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ed78824d-596a-57ec-87ee-d394bfdf3f73
		summarizeBy: none
		sourceColumn: CanalID

		annotation SummarizationSetBy = Automatic

	column DataMes
		dataType: dateTime
		isHidden
		formatString: dd/MM/yyyy
		lineageTag: 99ab1f1d-f056-5d37-bf2e-d169e0972dba
		summarizeBy: none
		sourceColumn: DataMes

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Investimento
		dataType: double
		isHidden
		formatString: R$ #,0.00
		lineageTag: fe4b4ca1-22aa-58dd-bac1-7c26cc8146d7
		summarizeBy: none
		sourceColumn: Investimento

		annotation SummarizationSetBy = Automatic

	column Impressoes
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b13acf8e-c457-5c1d-8f44-3f446bb83d17
		summarizeBy: none
		sourceColumn: Impressoes

		annotation SummarizationSetBy = Automatic

	column Cliques
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2a5661a5-3648-5de5-adfa-455cea6f54e1
		summarizeBy: none
		sourceColumn: Cliques

		annotation SummarizationSetBy = Automatic

	column Visitantes
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a75902d0-6c33-55b7-8fd6-3792ef98f8a1
		summarizeBy: none
		sourceColumn: Visitantes

		annotation SummarizationSetBy = Automatic

	column Leads
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0487044b-cb85-5a27-bccc-2215193ded15
		summarizeBy: none
		sourceColumn: Leads

		annotation SummarizationSetBy = Automatic

	column NovosClientes
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: bb41e915-dd17-53a4-aeaf-561c8646cb56
		summarizeBy: none
		sourceColumn: NovosClientes

		annotation SummarizationSetBy = Automatic

	partition fMarketing = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(PastaDados & "fMarketing.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
					Colunas = Table.SelectColumns(Cabecalho, {"MarketingID", "CanalID", "DataMes", "Investimento", "Impressoes", "Cliques", "Visitantes", "Leads", "NovosClientes"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"MarketingID", Int64.Type}, {"CanalID", Int64.Type}, {"DataMes", type date}, {"Investimento", type number}, {"Impressoes", Int64.Type}, {"Cliques", Int64.Type}, {"Visitantes", Int64.Type}, {"Leads", Int64.Type}, {"NovosClientes", Int64.Type}}, "en-US")
				in
					Tipos

	annotation PBI_ResultType = Table

