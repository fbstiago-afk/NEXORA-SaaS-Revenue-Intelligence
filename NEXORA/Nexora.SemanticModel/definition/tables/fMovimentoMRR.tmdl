	partition fMovimentoMRR = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(PastaDados & "fMovimentoMRR.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
					Colunas = Table.SelectColumns(Cabecalho, {"MovimentoID", "ClienteID", "DataMes", "TipoMovimento", "Subtipo", "PlanoID", "PlanoAnteriorID", "ValorMRR", "MotivoChurn", "SinalMovimento"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"MovimentoID", Int64.Type}, {"ClienteID", Int64.Type}, {"DataMes", type date}, {"TipoMovimento", type text}, {"Subtipo", type text}, {"PlanoID", Int64.Type}, {"PlanoAnteriorID", Int64.Type}, {"ValorMRR", type number}, {"MotivoChurn", type text}, {"SinalMovimento", Int64.Type}}, "en-US")
				in
					Tipos

	annotation PBI_ResultType = Table

