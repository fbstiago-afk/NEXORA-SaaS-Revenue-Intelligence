	partition fSnapshotMRR = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(PastaDados & "fSnapshotMRR.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
					Colunas = Table.SelectColumns(Cabecalho, {"SnapshotID", "ClienteID", "DataMes", "PlanoID", "TipoCobranca", "MRRPlano", "MRRUsuariosExtras", "MRRAddOns", "MRR", "Usuarios", "IdadeCohort", "ReceitaRecorrenteReconhecida"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"SnapshotID", Int64.Type}, {"ClienteID", Int64.Type}, {"DataMes", type date}, {"PlanoID", Int64.Type}, {"TipoCobranca", type text}, {"MRRPlano", type number}, {"MRRUsuariosExtras", type number}, {"MRRAddOns", type number}, {"MRR", type number}, {"Usuarios", Int64.Type}, {"IdadeCohort", Int64.Type}, {"ReceitaRecorrenteReconhecida", type number}}, "en-US")
				in
					Tipos

	annotation PBI_ResultType = Table

