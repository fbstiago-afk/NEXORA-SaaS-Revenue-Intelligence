	partition fSuporte = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(PastaDados & "fSuporte.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
					Colunas = Table.SelectColumns(Cabecalho, {"TicketID", "ClienteID", "DataAbertura", "Categoria", "Prioridade", "SLAHoras", "TempoPrimeiraRespostaH", "TempoResolucaoH", "DentroSLA", "Satisfacao"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"TicketID", Int64.Type}, {"ClienteID", Int64.Type}, {"DataAbertura", type date}, {"Categoria", type text}, {"Prioridade", type text}, {"SLAHoras", Int64.Type}, {"TempoPrimeiraRespostaH", type number}, {"TempoResolucaoH", type number}, {"DentroSLA", type text}, {"Satisfacao", Int64.Type}}, "en-US")
				in
					Tipos

	annotation PBI_ResultType = Table

