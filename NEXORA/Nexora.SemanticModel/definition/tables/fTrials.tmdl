					Fonte = Csv.Document(File.Contents(PastaDados & "fTrials.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
					Colunas = Table.SelectColumns(Cabecalho, {"TrialID", "CanalID", "SegmentoID", "PorteID", "PlanoInteresseID", "DataInicioTrial", "DuracaoDias", "Convertido", "DataConversao", "LoginsTrial"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"TrialID", Int64.Type}, {"CanalID", Int64.Type}, {"SegmentoID", Int64.Type}, {"PorteID", Int64.Type}, {"PlanoInteresseID", Int64.Type}, {"DataInicioTrial", type date}, {"DuracaoDias", Int64.Type}, {"Convertido", type text}, {"DataConversao", type date}, {"LoginsTrial", Int64.Type}}, "en-US")
				in
					Tipos

	annotation PBI_ResultType = Table

